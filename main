# ── Selector: which participant + state to analyse (single mode) ─────────────
PARTICIPANT = 'P-021'  # any key in PARTICIPANTS
STATE = 'ON'  # 'OFF' or 'ON'

# ── Run mode / outputs ───────────────────────────────────────────────────────
BATCH_MODE = True  # True: all participants/states → workbooks. False: PARTICIPANT/STATE + dashboard.
DRY_RUN = True  # True: write nothing (batch = preflight only; single = no workbook). False: write.
OUTPUT_DIR = '/Users/aecasagr/Desktop/PD_HRV/HRV_Values_v2'  # new folder; September files untouched


def resolve_participant_paths(participant, state):
    """Build absolute (edf_dir, file_pattern, sync_csv, trial_sheet) for a
    participant/state from the registry. Raises a clear error if the key or the
    requested state is missing (e.g. P-007 has no ON recording)."""
    if participant not in PARTICIPANTS:
        raise KeyError(f"Unknown participant '{participant}'. "
                       f"Choose one of: {', '.join(PARTICIPANTS)}")
    cfg = PARTICIPANTS[participant]
    key = state.strip().lower()
    if key not in ('off', 'on'):
        raise ValueError(f"STATE must be 'OFF' or 'ON', got '{state}'")
    pattern = cfg.get(key)
    if not pattern:
        raise ValueError(f"{participant} has no {state.upper()}-state file configured "
                         f"(set STATE to a state that exists for this participant)")
    pdir = os.path.join(BASE, participant)
    return {
        'edf_dir': os.path.join(pdir, cfg['edf_subdir']),
        'pattern': pattern,  # one glob pattern or a list of them [D25]
        'sync': os.path.join(pdir, cfg['sync']),
        'trial_sheet': os.path.join(pdir, cfg['trial_sheet']),
        'ecg_channel': dict(cfg.get('ecg_channel') or {}),  # per-trial ECG lead [D27]
    }


def find_edf_files(paths):
    """[D25] The state's EDF files: every file matching its glob pattern, or any
    of its patterns when the registry lists several. Sorted, no duplicates."""
    pats = paths['pattern'] if isinstance(paths['pattern'], (list, tuple)) else [paths['pattern']]
    found = set()
    for pat in pats:
        found.update(glob.glob(os.path.join(paths['edf_dir'], pat)))
    return sorted(found)


ECG_CHANNEL = 'ECG 1'
INVERT_ECG = True
SNAP_WINDOW = 0.05
NOISE_THRESHOLD = 0.12
PAD_SECONDS = 5
EPOCH_TMIN = -0.2
EPOCH_TMAX = 0.6
OUTLIER_THRESHOLD = 0.30
MEDIAN_WINDOW = 11
MIN_RR_MS = 280
MAX_RR_MS = 2000
MORPHOLOGY_CORRELATION_THRESHOLD = 0.75
# ── Adaptive (Lipponen–Tarvainen–inspired) RR-outlier detection ──────────────
# Replaces the fixed ±OUTLIER_THRESHOLD rule with a threshold that scales to the
# LOCAL beat-to-beat variability, so tolerance widens where variability is
# genuinely high (e.g. walking → fewer false positives) and tightens where the
# rhythm is stable (catching subtle ectopics a fixed ±% rule misses). Runs
# ALONGSIDE the morphology detector, which is OR-combined in _interval_bad_mask.
# ── Artefact detection method ────────────────────────────────────────────────
# 'kubios'    : faithful Lipponen–Tarvainen (2019) automatic detection — dRR
#               sign-pattern classification (ectopic / missed / extra / long-short),
#               the exact method Kubios' "Automatic correction" uses.
# 'threshold' : legacy fixed ±OUTLIER_THRESHOLD deviation-from-local-median rule
#               (approximates Kubios' "Threshold correction").
DETECTION_METHOD = 'kubios'
KUBIOS_ALPHA = 8.0  # INCREASED from 5.2. Widens the threshold for normal beat-to-beat variability.
KUBIOS_WINDOW_BEATS = 91  # sliding window for the time-varying threshold (90 + centre)
KUBIOS_MEDFILT = 11  # window for the local median RR (medRR; 10 + centre)
KUBIOS_C1 = 0.13  # ectopic subspace slope (dimensionless)
KUBIOS_C2 = 0.17  # ectopic subspace intercept (dimensionless)
KUBIOS_MRRS_THRESH = 4.5  # INCREASED from 3.0. Requires a larger relative deviation from the median to trigger.
KUBIOS_TH_FLOOR_MS = 35.0  # absolute floor (ms) on Th1/Th2 — was a literal inside
#                             _kubios_threshold(); value unchanged. 0 ⇒ published behaviour.
KUBIOS_TH_CEIL_FRAC = 0.20  # [D16] ceiling on Th1/Th2 as a fraction of the local median RR
#                             (medRR), so frequent ectopy cannot raise the thresholds above
#                             the ectopic beats themselves. None ⇒ no ceiling (2.2's detector
#                             when PREMATURE_MIN_FRAC and RR_REL_MIN_FRAC are None too).
PREMATURE_MIN_FRAC = 0.10  # [D18] a flagged interval this much shorter than the rhythm just
#                            before it (< 90 %) ends in an EARLY beat, so the interval after that
#                            beat is flagged too (both intervals around a premature beat are non-NN).
#                            None ⇒ off.
PREMATURE_GRID_TOL = 0.10  # [D18] … unless that beat is back on the sinus grid: the flagged run
#                            ending with it totals a whole number of beats (±10 %), as after an
#                            extra beat or a late beat.
RR_REL_MIN_FRAC = 0.60  # [D19] an interval shorter than 60 % of the local rhythm is never a
#                         normal-to-normal interval (spurious detections in noise); flagged
#                         with the out-of-range intervals. None ⇒ off.
RHYTHM_HALF_WINDOW = 15  # [D19] local rhythm = median of the unflagged intervals within ±15
#                          intervals (also [D18]'s fallback when < 3 NN intervals precede a run)
ALTERNATION_HANDLING = 'auto'  # [D21, D28] short–long alternation (a bigeminal rhythm) is flagged; then
#                                'auto' (default): a SHORT stretch inside normal rhythm is corrected like any
#                                premature beats (every beat kept and re-timed, values from the rhythm
#                                around it); a SUSTAINED one — longer than MAX_REPLACE_RUN_SEC, or where
#                                alternation fills ≥ ALTERNATION_SUSTAINED_FRAC of the beats around it, or
#                                at the edge of the recording — is left out, not reconstructed.
#                                'exclude': every stretch left out (2.5). 'keep': treated as
#                                normal-to-normal (a sensitivity run, e.g. if a clinician reads the strip
#                                as sinus rhythm; it also keeps true bigeminy). 'off' = 2.4 behaviour.
ALTERNATION_MIN_AMP = 0.05  # [D21] each interval ≥ 5 % above or below the mean of its pair …
ALTERNATION_MIN_RUN = 8  # [D21] … for 8 successive differences alternating in sign (9 intervals) …
ALTERNATION_PAIR_MIN_BEATS = 1.5  # [D21] … and each short + long pair spanning ≥ 1.5 beats of the rhythm
#                                   around the stretch (two beats: bigeminy). A pair holding ONE beat is
#                                   a beat split by an extra detection — left to the extra-beat rules.
ALTERNATION_CONTEXT_BEATS = 30  # [D28] intervals looked at on each side of a stretch …
ALTERNATION_SUSTAINED_FRAC = 0.25  # [D28] … the stretch is sustained if ≥ 25 % of them alternate too
EARLY_CHECK_FRAC = 0.90  # [D24] QC only (nothing is flagged): an UNFLAGGED interval < 90 % of the local
#                          median (9 intervals) whose neighbours are both ≥ 95 % of it ends in a slightly
#                          early beat — a late premature beat below the detector's 20 % resolution.
EARLY_CHECK_WARN_PCT = 5.0  # [D24] warn (console + dashboard) when ≥ 5 % of a trial's intervals are such
EARLY_BEAT_HANDLING = 'report'  # [D24] 'report' (default): count them only (Data_Quality:
#                                 Unflagged_Early_Beats_Percent). 'flag': treat them as premature beats
#                                 (flagged; [D18] usually adds the interval after them).
RECORDING_GAP_HANDLING = 'exclude'  # [D26] where the ECG RECORDING has a hole inside a trial (the Equivital
#                                     was restarted, leaving ~30 s between two EDF files), the interval across
#                                     the hole is excluded — never bridged or filled with inserted beats.
#                                     'off' = previous behaviour (the samples either side are simply joined).
RECORDING_GAP_MIN_SEC = 0.5  # [D26] a jump between consecutive ECG time stamps longer than this is a hole
MIN_SEGMENT_DURATION = 120
ADAPTIVE_EPOCH = True
EPOCH_POST_RR_FRACTION = 0.65
EPOCH_PRE_RR_FRACTION = 0.20
ROLLING_TEMPLATE = True
TEMPLATE_WINDOW_SEC = 90
TEMPLATE_N_BEATS = 50
CLOCK_OFFSET_SECONDS = 0.0
USE_LONGEST_FILE_ONLY = False  # False = read ALL matching EDFs and match by time

# ── Physiology-driven RR reconstruction (replaces opaque MAX_FILL_BEATS cap) ──
# A flagged gap implies round(gap / RR_local) physiologic intervals.
MAX_MISSED_BEATS = 4  # max consecutive missed beats we will synthesise
MAX_GAP_RECONSTRUCT_SEC = 5.0  # true INSERTION gaps longer than this are unrecoverable
MAX_REPLACE_RUN_SEC = 15.0  # a run of PRESENT-but-flagged beats (k≈L, nothing to
# insert) longer than this is excluded rather than
# replaced, to avoid fabricating a long flat segment.
# Raise it to replace longer stretches, lower it to
# exclude more. Only the exclude-all 'clean' path is
# unaffected by this knob.
EXTRA_BEAT_RATIO = 1.5  # gap/RR_local below this ⇒ extra/false beat(s)

# ── Values of reconstructed intervals (v2) ───────────────────────────────────
RR_FILL_METHOD = 'gpr'  # 'gpr'  : values from the GP (default) [D1, D3]
#                         'equal': no GP — equal values within a run (RR_local) [D11]
GPR_KERNEL = 'rq'  # 'rq': RationalQuadratic + White [D1];  'rbf': previous kernel (sensitivity)
GPR_N_RESTARTS = 2  # optimizer restarts (as before) …
GPR_RANDOM_STATE = 0  # … now seeded, so reruns are identical [D4]
GPR_MIN_TRAIN = 4  # fewer clean intervals than this ⇒ no GP (equal division / local median)
RR_SUM_CONSTRAINT = 'detection'  # values sum to the gap for missed/extra-beat runs only (default) [D2];
#                                   'all': every run (Kubios-like); 'none': never (sensitivity analyses)
RR_SUM_MAX_OFFSET = 0.10  # 'detection' only: sum-constrain a missed/extra-beat run only if gap/k is
#                            within 10 % of RR_local; otherwise the beat count is ambiguous [D2]

# ── Benchmark acceptance criteria (vs Kubios / Lipponen–Tarvainen) ────────────
# Relative agreement a metric must reach to PASS. WARN = within 2× tolerance.
# Defaults are reproducibility-based conventions, NOT clinical-equivalence
# limits — tune per study. HR is judged on an absolute bpm difference.
BENCHMARK_TOLERANCES = {
    'HR_abs_bpm': 1.0,  # mean HR within ±1 bpm
    'SDNN': 0.05,  # ±5 %
    'RMSSD': 0.05,  # ±5 %
    'pNN50': 0.10,  # ±10 % (proportion metric, more variable)
    'LF/HF': 0.15,  # ±15 % (frequency ratios are noisier)
}
RUN_BENCHMARK = True  # set False to skip the Kubios cross-check

PROCESSED_DATA = {}


# ─────────────────────────────────────────────────────────────────────────────
# SIGNAL UTILITIES
# ─────────────────────────────────────────────────────────────────────────────
def snap_to_local_max(signal, peak_indices, fs, window_seconds=0.05):
    window_samples = int(window_seconds * fs / 2)
    corrected_peaks = []
    for peak in peak_indices:
        start = max(0, peak - window_samples)
        end = min(len(signal), peak + window_samples)
        if start >= end:
            corrected_peaks.append(peak)
            continue
        corrected_peaks.append(start + np.argmax(signal[start:end]))
    return np.array(corrected_peaks)


def remove_small_peaks(signal, peak_indices, ratio=0.18):
    if len(peak_indices) == 0:
        return peak_indices
    amplitudes = signal[peak_indices.astype(int)]
    return peak_indices[amplitudes > np.median(amplitudes) * ratio]


def clean_artifact_peaks(peak_indices, signal, fs):
    if len(peak_indices) < 2:
        return peak_indices
    sorted_indices = np.sort(peak_indices)
    min_dist = int(MIN_RR_MS / 1000 * fs)
    keep = np.ones(len(sorted_indices), dtype=bool)
    i = 0
    while i < len(sorted_indices) - 1:
        cur, nxt = sorted_indices[i], sorted_indices[i + 1]
        if (nxt - cur) < min_dist:
            if signal[int(cur)] < signal[int(nxt)]:
                keep[i] = False
            else:
                keep[i + 1] = False
                i += 1
        i += 1
    return sorted_indices[keep]


# ─────────────────────────────────────────────────────────────────────────────
# LOG FILE PARSING
# ─────────────────────────────────────────────────────────────────────────────
def parse_log_file_new(filepath, base_date):
    try:
        try:
            df = pd.read_csv(filepath, sep='\t')
            if len(df.columns) < 3:
                df = pd.read_csv(filepath, sep=',')
        except Exception:
            df = pd.read_csv(filepath, sep=None, engine='python')
        df.columns = [str(c).strip().replace('\ufeff', '') for c in df.columns]
        ts_col = next((c for c in df.columns if 'timestamp' in c.lower()), None)
        trial_col = next((c for c in df.columns if 'trial' in c.lower()), None)
        event_col = next((c for c in df.columns if 'event' in c.lower()), None)
        if not ts_col or not trial_col or not event_col:
            print(f"❌ Missing required columns. Found: {list(df.columns)}")
            return []

        def combine_date_time(ts_str):
            try:
                parsed_dt = pd.to_datetime(str(ts_str).split(' GMT')[0].strip())
                return pd.Timestamp.combine(base_date.date(), parsed_dt.time())
            except Exception:
                return pd.NaT

        df['dt'] = df[ts_col].apply(combine_date_time)
        trials, current_start, current_name = [], None, None
        for _, row in df.iterrows():
            event = str(row[event_col]).strip().lower()
            name = str(row[trial_col]).strip()
            if event == 'start':
                current_start, current_name = row['dt'], name
            elif event == 'stop' and current_name == name:
                if pd.notna(current_start) and pd.notna(row['dt']):
                    trials.append({'name': name, 'start': current_start, 'stop': row['dt']})
                current_start = current_name = None
        return trials
    except Exception as e:
        print(f"Error parsing log file: {e}")
        traceback.print_exc()
        return []


# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE CONSTRUCTION
# ─────────────────────────────────────────────────────────────────────────────
def _build_single_template(signal, peak_indices, fs):
    t_min_s = int(EPOCH_TMIN * fs)
    t_max_s = int(EPOCH_TMAX * fs)
    if len(peak_indices) == 0:
        return np.zeros(max(1, t_max_s - t_min_s))
    amps = signal[peak_indices.astype(int)]
    order = np.argsort(np.abs(amps - np.median(amps)))
    chosen = peak_indices[order[:TEMPLATE_N_BEATS]]
    beats = [signal[int(p + t_min_s):int(p + t_max_s)]
             for p in chosen
             if int(p + t_min_s) >= 0 and int(p + t_max_s) < len(signal)]
    if not beats:
        return np.zeros(max(1, t_max_s - t_min_s))
    min_len = min(len(b) for b in beats)
    return np.median([b[:min_len] for b in beats], axis=0)


def build_templates(signal, peak_indices, fs):
    global_template = _build_single_template(signal, peak_indices, fs)
    if not ROLLING_TEMPLATE or len(peak_indices) == 0:
        return lambda _: global_template, global_template
    win_samples = int(TEMPLATE_WINDOW_SEC * fs)
    if win_samples <= 0:
        return lambda _: global_template, global_template
    window_templates = {}
    win_ids = peak_indices.astype(int) // win_samples
    for wid in np.unique(win_ids):
        members = peak_indices[win_ids == wid]
        window_templates[int(wid)] = (
            _build_single_template(signal, members, fs)
            if len(members) >= max(10, TEMPLATE_N_BEATS // 4)
            else global_template
        )

    def template_for(peak_sample):
        return window_templates.get(int(int(peak_sample) // win_samples), global_template)

    return template_for, global_template


# ─────────────────────────────────────────────────────────────────────────────
# ECTOPIC / OUTLIER DETECTION
# ─────────────────────────────────────────────────────────────────────────────
def _local_rr_samples(peak_indices, idx, fs):
    rr = np.diff(peak_indices)
    if len(rr) == 0:
        return fs
    lo, hi = max(0, idx - MEDIAN_WINDOW // 2), min(len(rr), idx + MEDIAN_WINDOW // 2 + 1)
    window = rr[lo:hi]
    return float(np.median(window)) if len(window) else float(np.median(rr))


def detect_ectopic_beats(peak_indices, signal, fs, template_for):
    n = len(peak_indices)
    if n < 5:
        return np.zeros(n, dtype=bool)
    abs_pre, abs_post = int(EPOCH_TMIN * fs), int(EPOCH_TMAX * fs)
    correlations = []
    for i, peak in enumerate(peak_indices):
        peak = int(peak)
        template_beat = template_for(peak)
        if len(template_beat) == 0:
            correlations.append(1.0)
            continue
        if ADAPTIVE_EPOCH:
            local_rr = _local_rr_samples(peak_indices, i, fs)
            pre = -int(min(abs(abs_pre), EPOCH_PRE_RR_FRACTION * local_rr))
            post = int(min(abs_post, EPOCH_POST_RR_FRACTION * local_rr))
        else:
            pre, post = abs_pre, abs_post
        start, end = peak + pre, post + peak
        if start < 0 or end > len(signal) or end <= start:
            correlations.append(0.0)
            continue
        beat = signal[start:end]
        t_offset = pre - abs_pre
        t_slice = template_beat[t_offset:t_offset + (end - start)]
        min_len = min(len(beat), len(t_slice))
        if min_len < 3:
            correlations.append(0.0)
            continue
        b, t = beat[:min_len], t_slice[:min_len]
        correlations.append(
            np.corrcoef(b, t)[0, 1] if np.std(b) > 0 and np.std(t) > 0 else 0.0
        )
    return np.array(correlations) < MORPHOLOGY_CORRELATION_THRESHOLD


def _kubios_threshold(sig, alpha, window, ceiling=None):
    """Time-varying threshold = alpha × quartile-deviation of |sig| over a
    centred rolling window (Lipponen–Tarvainen 2019, eq. for Th1/Th2), bounded
    below by KUBIOS_TH_FLOOR_MS and — when `ceiling` (ms, one value per beat)
    is given — above by it [D16]."""
    s = pd.Series(np.abs(np.asarray(sig, dtype=float)))
    q1 = s.rolling(window, center=True, min_periods=1).quantile(0.25).to_numpy()
    q3 = s.rolling(window, center=True, min_periods=1).quantile(0.75).to_numpy()

    # Calculate the original dynamic threshold
    dynamic_thresh = alpha * ((q3 - q1) / 2.0)

    # HARD FLOOR FIX:
    # If the rhythm is extremely stable (e.g., standing still), the IQR approaches zero.
    # This forces a minimum absolute threshold of KUBIOS_TH_FLOOR_MS (35 ms) so tiny
    # hardware dips aren't falsely flagged as ectopy.
    th = np.maximum(dynamic_thresh, KUBIOS_TH_FLOOR_MS)

    # CEILING [D16]: the quartile deviation stops being robust once more than about
    # a quarter of the beats in the window are abnormal. With frequent ectopy the
    # threshold then grows past the ectopic beats themselves (P-009 ON 5-min sitting:
    # Th1 1.6–2.1 s at a 1.27-s rhythm) and they are read as normal variability.
    if ceiling is not None:
        th = np.minimum(th, np.maximum(np.asarray(ceiling, dtype=float), KUBIOS_TH_FLOOR_MS))
    return th


def kubios_find_artifacts(rr_ms):
    """Faithful port of the Lipponen–Tarvainen (2019) / Kubios automatic
    artefact detector (the same algorithm as NeuroKit2 signal_fixpeaks
    method='kubios'). Operates on an RR series (ms) and classifies each BEAT
    into ectopic / missed / extra / long-short using dRR sign-pattern subspaces.

    Returns (classes, info) where classes maps each label to a list of BEAT
    indices in a PEAK-indexed RR series (rr[i] = interval ending at peak i;
    rr has one more element than the input interval series), and info carries
    medRR and the Th2 threshold (peak-indexed) for the plot band.
    Departures from the reference: KUBIOS_ALPHA, KUBIOS_MRRS_THRESH, the
    threshold floor and (2.3) the threshold ceiling [D16]."""
    rr_ms = np.asarray(rr_ms, dtype=float)
    m = len(rr_ms)
    empty = {k: [] for k in ('ectopic', 'missed', 'extra', 'longshort')}
    if m < 3:
        return empty, {'medrr': np.array([]), 'th2': np.array([]), 'n_peaks': m + 1}

    # Peak-indexed RR (matches the reference: rr[0] = mean of the rest).
    rr = np.concatenate([[float(np.mean(rr_ms))], rr_ms])
    n = len(rr)

    # Local median RR — the published medRR, computed first because it also scales
    # the threshold ceiling [D16].
    medrr = (pd.Series(rr).rolling(KUBIOS_MEDFILT, center=True, min_periods=1)
             .median().to_numpy())
    ceiling = KUBIOS_TH_CEIL_FRAC * medrr if KUBIOS_TH_CEIL_FRAC else None

    drrs = np.ediff1d(rr, to_begin=0)
    drrs[0] = float(np.mean(drrs[1:])) if n > 1 else 0.0
    th1 = _kubios_threshold(drrs, KUBIOS_ALPHA, KUBIOS_WINDOW_BEATS, ceiling)
    with np.errstate(invalid='ignore', divide='ignore'):
        drrs = np.divide(drrs, th1, out=np.full_like(drrs, np.nan), where=th1 != 0)

    padding = 2
    drrs_pad = np.pad(drrs, padding, 'reflect')
    s12 = np.zeros(n)
    s22 = np.zeros(n)
    for d in range(padding, padding + n):
        if drrs_pad[d] > 0:
            s12[d - padding] = np.max([drrs_pad[d - 1], drrs_pad[d + 1]])
        elif drrs_pad[d] < 0:
            s12[d - padding] = np.min([drrs_pad[d - 1], drrs_pad[d + 1]])
        if drrs_pad[d] >= 0:
            s22[d - padding] = np.min([drrs_pad[d + 1], drrs_pad[d + 2]])
        elif drrs_pad[d] < 0:
            s22[d - padding] = np.max([drrs_pad[d + 1], drrs_pad[d + 2]])

    mrrs = rr - medrr
    mrrs[mrrs < 0] = mrrs[mrrs < 0] * 2
    th2 = _kubios_threshold(mrrs, KUBIOS_ALPHA, KUBIOS_WINDOW_BEATS, ceiling)
    with np.errstate(invalid='ignore', divide='ignore'):
        mrrs_n = np.divide(mrrs, th2, out=np.full_like(mrrs, np.nan), where=th2 != 0)

    c1, c2 = KUBIOS_C1, KUBIOS_C2
    extra_idcs, missed_idcs, ectopic_idcs, longshort_idcs = [], [], [], []
    i = 0
    while i < n - 2:
        if np.abs(drrs[i]) <= 1:
            i += 1
            continue
        eq1 = (drrs[i] > 1) and (s12[i] < (-c1 * drrs[i] - c2))
        eq2 = (drrs[i] < -1) and (s12[i] > (-c1 * drrs[i] + c2))
        if eq1 or eq2:
            ectopic_idcs.append(i)
            i += 1
            continue
        # UPDATED: Use the new KUBIOS_MRRS_THRESH configuration
        if not ((np.abs(drrs[i]) > 1) or (np.abs(mrrs_n[i]) > KUBIOS_MRRS_THRESH)):
            i += 1
            continue
        longshort_candidates = [i]
        if np.abs(drrs[i + 1]) < np.abs(drrs[i + 2]):
            longshort_candidates.append(i + 1)
        for j in longshort_candidates:
            eq3 = (drrs[j] > 1) and (s22[j] < -1)
            # UPDATED: Use the new KUBIOS_MRRS_THRESH configuration
            eq4 = np.abs(mrrs_n[j]) > KUBIOS_MRRS_THRESH
            eq5 = (drrs[j] < -1) and (s22[j] > 1)
            if not (eq3 or eq4 or eq5):
                i += 1
                continue
            eq6 = np.abs(rr[j] / 2 - medrr[j]) < th2[j]
            eq7 = np.abs(rr[j] + rr[j + 1] - medrr[j]) < th2[j]
            if eq5 and eq7:
                extra_idcs.append(j)
                i += 1
                continue
            if eq3 and eq6:
                missed_idcs.append(j)
                i += 1
                continue
            longshort_idcs.append(j)
            i += 1

    classes = {'ectopic': ectopic_idcs, 'missed': missed_idcs,
               'extra': extra_idcs, 'longshort': longshort_idcs}
    return classes, {'medrr': medrr, 'th2': th2, 'n_peaks': n}


def kubios_interval_masks(rr_ms):
    """Map Kubios BEAT classes to the user's INTERVAL indexing (length == len(rr_ms)).
    Peak-indexed rr[i] is the interval ENDING at peak i, i.e. user interval i-1.
      • missed / long-short at i: the abnormal interval is rr[i] → user i-1.
      • extra at i: peak i is the false beat; its two intervals → user (i-1, i).
      • ectopic at i [D13]: the class index is the CENTRE of the dRR pattern
        (e.g. the long interval of short-long), so the abnormal beat is peak i-1
        and its two intervals are rr[i-1], rr[i] → user (i-2, i-1). Mapping it
        to (i-1, i), as before, missed the premature beat's short interval and
        flagged the normal interval after the pause instead."""
    m = len(rr_ms)
    masks = {k: np.zeros(m, dtype=bool) for k in ('ectopic', 'missed', 'extra', 'longshort')}
    if m < 3:
        return masks
    classes, _ = kubios_find_artifacts(rr_ms)

    def mark(mask, j):
        if 0 <= j < m:
            mask[j] = True

    for i in classes['missed']:
        mark(masks['missed'], i - 1)
    for i in classes['longshort']:
        mark(masks['longshort'], i - 1)
    for i in classes['ectopic']:
        mark(masks['ectopic'], i - 2)
        mark(masks['ectopic'], i - 1)
    for i in classes['extra']:
        mark(masks['extra'], i - 1)
        mark(masks['extra'], i)
    return masks


def compute_rr_bounds(rr_ms):
    """Per-interval (lower, upper, center) reference band for the tachogram.
    'threshold' mode: local median ± OUTLIER_THRESHOLD (what that method flags).
    'kubios' mode: local median with the long/short bound (medRR + 3·Th2 above,
    medRR − 1.5·Th2 below — asymmetric because Kubios doubles negative deviations).
    The band is a visual reference for the median-deviation part only; ectopic/
    missed/extra flags are pattern-based and can sit inside the band."""
    rr_ms = np.asarray(rr_ms, dtype=float)
    m = len(rr_ms)
    if DETECTION_METHOD == 'kubios' and m >= 3:
        _, info = kubios_find_artifacts(rr_ms)
        medrr = info['medrr'][1:1 + m]  # peak→interval alignment
        th2 = info['th2'][1:1 + m]
        return medrr - 1.5 * th2, medrr + 3.0 * th2, medrr
    center = (pd.Series(rr_ms)
              .rolling(window=MEDIAN_WINDOW, center=True, min_periods=1)
              .median().to_numpy())
    half = OUTLIER_THRESHOLD * center
    return center - half, center + half, center


def _local_rhythm(rr_ms, flagged, half=None):
    """Local sinus rhythm per interval: median of the UNFLAGGED intervals within
    ±half intervals (the published 11-beat medRR is pulled toward the ectopic
    beats when they are frequent). Falls back to the trial's unflagged median,
    then to the median of everything."""
    half = RHYTHM_HALF_WINDOW if half is None else half
    half = max(2, int(half)) if half else 15
    rr_ms = np.asarray(rr_ms, dtype=float)
    n = len(rr_ms)
    clean = np.where(np.asarray(flagged, dtype=bool), np.nan, rr_ms)
    s = pd.Series(clean)
    loc = s.rolling(2 * half + 1, center=True, min_periods=5).median().to_numpy()
    fallback = float(np.nanmedian(clean)) if np.any(np.isfinite(clean)) else float(np.median(rr_ms)) if n else np.nan
    return np.where(np.isfinite(loc), loc, fallback)


def _premature_beat_intervals(rr_ms, flagged, rhythm):
    """[D18] (cur, nxt): flagged SHORT intervals that end in an early beat, and
    the unflagged interval that starts at that beat. The Lipponen–Tarvainen
    detector reports a premature beat as 'ectopic' (both intervals) only when
    the rhythm drops straight back after the pause; with a sinus-resetting
    pause, or post-extrasystolic lengthening that lasts several beats, it flags
    only the short interval ('long/short'), and the interval after the early
    beat stayed in the NN series.
    Each run of flagged intervals is examined at its end, against the rhythm
    just BEFORE the run (median of the last 5 NN intervals within 15; else the
    local rhythm): prematurity is relative to the preceding cycle, and a
    ±15-interval median is off wherever the rate changes. The run's last
    interval is completed (the next one flagged too) when it is shorter than
    (1 − PREMATURE_MIN_FRAC) × that rhythm — unless the run has two or more
    intervals and its total is a whole number of beats (± PREMATURE_GRID_TOL):
    the beat ending it is then back on the sinus grid (an extra beat: short
    intervals summing to one beat; a late beat: long + short). If the interval
    just completed is itself short (premature beats in a row), the next one is
    examined the same way, at most 3 times per run."""
    rr_ms = np.asarray(rr_ms, dtype=float)
    flagged = np.asarray(flagged, dtype=bool)
    n = len(rr_ms)
    cur, nxt = np.zeros(n, dtype=bool), np.zeros(n, dtype=bool)
    if not PREMATURE_MIN_FRAC or n < 3:
        return cur, nxt
    tol = PREMATURE_GRID_TOL or 0.0
    nn_ok = ~flagged                             # NN so far (completed intervals are removed)
    i = 0
    while i < n:
        if not flagged[i]:
            i += 1
            continue
        s = i                                    # run [s, e] of flagged intervals
        while i + 1 < n and flagged[i + 1]:
            i += 1
        before = rr_ms[max(0, s - 15):s][nn_ok[max(0, s - 15):s]][-5:]
        ref = float(np.median(before)) if len(before) >= 3 else float(rhythm[i])
        c = i
        while c + 1 < n and not flagged[c + 1] and c - i < 3:
            if not (ref > 0) or rr_ms[c] >= (1.0 - PREMATURE_MIN_FRAC) * ref:
                break                            # the beat ending c is not early
            if c > s:                            # back on the sinus grid?
                beats = float(rr_ms[s:c + 1].sum()) / ref
                if round(beats) >= 1 and abs(beats - round(beats)) <= tol:
                    break
            cur[c] = nxt[c + 1] = True
            nn_ok[c + 1] = False
            c += 1
        i += 1
    return cur, nxt


def _alternation_mask(rr_ms):
    """[D21] Intervals inside a sustained short–long alternation: at least
    ALTERNATION_MIN_RUN successive differences in a row alternate in sign, each
    interval is at least ALTERNATION_MIN_AMP above or below the mean of its pair
    (|ΔRR| ≥ 2 × ALTERNATION_MIN_AMP × pair mean), and a short + long pair spans
    two beats of the rhythm around the stretch (median pair ≥
    ALTERNATION_PAIR_MIN_BEATS × the median of up to 15 intervals on either
    side; with fewer than 3 such intervals it is taken as two). Breathing
    cannot do this (it spans 3–6 beats); a bigeminal rhythm does — an early
    beat every other beat, however normal each beat looks. [D28] The stretch
    starts at its first SHORT interval (the one ending the first early beat):
    the longer interval before it is the normal interval before that beat and
    is not part of it. If the stretch ends on a short interval, the interval
    after that last early beat is included."""
    rr_ms = np.asarray(rr_ms, dtype=float)
    n = len(rr_ms)
    out = np.zeros(n, dtype=bool)
    if n < 3 or not ALTERNATION_MIN_AMP or not ALTERNATION_MIN_RUN:
        return out
    d = np.diff(rr_ms)
    big = np.abs(d) >= ALTERNATION_MIN_AMP * (rr_ms[1:] + rr_ms[:-1])
    i = 0
    while i < len(d):
        if not big[i]:
            i += 1
            continue
        j = i
        while j + 1 < len(d) and big[j + 1] and np.sign(d[j + 1]) != np.sign(d[j]):
            j += 1
        if j - i + 1 >= ALTERNATION_MIN_RUN:      # differences i..j cover intervals i..j+1
            a, b = i, j + 1
            outside = np.r_[rr_ms[max(0, a - 15):a], rr_ms[b + 1:b + 16]]
            pairs = rr_ms[a:b] + rr_ms[a + 1:b + 1]
            if (len(outside) < 3 or not ALTERNATION_PAIR_MIN_BEATS
                    or np.median(pairs) >= ALTERNATION_PAIR_MIN_BEATS * np.median(outside)):
                s, e = a, b
                if rr_ms[s] > rr_ms[s + 1]:  # [D28] the normal interval before the first early beat
                    s += 1
                if rr_ms[e] < rr_ms[e - 1] and e + 1 < n:  # [D28] … and the one after the last early beat
                    e += 1
                out[s:e + 1] = True
        i = j + 1
    return out


def _true_runs(mask):
    """(start, end) index pairs of the runs of True in a boolean array (end inclusive)."""
    m = np.asarray(mask, dtype=bool)
    if not m.any():
        return []
    d = np.diff(np.r_[0, m.astype(np.int8), 0])
    return list(zip(np.where(d == 1)[0], np.where(d == -1)[0] - 1))


def _alternation_sustained(rr_ms, alt):
    """[D28] (n,) bool: the alternation stretches that cannot be corrected like
    premature beats, because the rhythm underneath is not observable around
    them: longer than MAX_REPLACE_RUN_SEC, or ≥ ALTERNATION_SUSTAINED_FRAC of
    the ALTERNATION_CONTEXT_BEATS intervals on either side alternate too (a
    bigeminal rhythm broken up only briefly, as in P-014), or fewer than 3
    intervals between the stretch and the start or end of the series, or fewer
    than 15 context intervals in all. Every other stretch is short and sits in
    normal rhythm (P-001's runs of four or five early beats): it is corrected."""
    rr_ms = np.asarray(rr_ms, dtype=float)
    alt = np.asarray(alt, dtype=bool)
    n = len(alt)
    out = np.zeros(n, dtype=bool)
    c = int(ALTERNATION_CONTEXT_BEATS)
    for s, e in _true_runs(alt):
        lo, hi = max(0, s - c), min(n, e + 1 + c)
        ctx = np.r_[np.arange(lo, s), np.arange(e + 1, hi)].astype(int)
        frac = float(alt[ctx].mean()) if len(ctx) else 1.0
        if (rr_ms[s:e + 1].sum() / 1000.0 > MAX_REPLACE_RUN_SEC or s - lo < 3 or hi - e - 1 < 3
                or len(ctx) < 15 or frac >= ALTERNATION_SUSTAINED_FRAC):
            out[s:e + 1] = True
    return out


def _check_options():
    """Typos in the 2.5 switches must not fall back silently to another behaviour."""
    if ALTERNATION_HANDLING not in ('auto', 'exclude', 'keep', 'off'):
        raise ValueError(f"ALTERNATION_HANDLING must be 'auto', 'exclude', 'keep' or 'off', got {ALTERNATION_HANDLING!r}")
    if EARLY_BEAT_HANDLING not in ('report', 'flag'):
        raise ValueError(f"EARLY_BEAT_HANDLING must be 'report' or 'flag', got {EARLY_BEAT_HANDLING!r}")
    if RECORDING_GAP_HANDLING not in ('exclude', 'off'):
        raise ValueError(f"RECORDING_GAP_HANDLING must be 'exclude' or 'off', got {RECORDING_GAP_HANDLING!r}")


def recording_gap_intervals(sample_index, peak_positions):
    """[D26] (m,) bool, one per beat interval: True where the ECG recording has
    a hole (consecutive time stamps more than RECORDING_GAP_MIN_SEC apart, i.e.
    two EDF files with a gap between them) between the interval's two beats.
    Such an interval measured in samples is not a heartbeat interval at all."""
    pk = np.asarray(peak_positions, dtype=np.int64)
    out = np.zeros(max(len(pk) - 1, 0), dtype=bool)
    if len(pk) < 2:  # detected under any setting (QC); only 'exclude' acts on it
        return out
    ns = pd.DatetimeIndex(sample_index).asi8
    jumps = np.where(np.diff(ns) > RECORDING_GAP_MIN_SEC * 1e9)[0]  # hole after sample j
    for j in jumps:
        k = int(np.searchsorted(pk, j + 1))  # first beat at or after the first sample past the hole
        if 1 <= k < len(pk):
            out[k - 1] = True
    return out


def unrecorded_seconds(sample_index, t_start, t_stop, sfreq):
    """[D26] Seconds of the trial window with no ECG samples (holes between EDF
    files, or a window that runs past the start/end of the recording)."""
    idx = pd.DatetimeIndex(sample_index)
    n_in = int(np.sum((idx >= t_start) & (idx <= t_stop)))
    return max(0.0, (t_stop - t_start).total_seconds() - n_in / float(sfreq))


def classify_rr_outlier_reasons(rr_ms):
    """Per-interval boolean masks by REASON, mutually exclusive by precedence, so
    flags can be colour-coded on the tachogram.

    'kubios' mode keys: 'hard', 'alternating', 'ectopic', 'missed', 'extra',
    'longshort'. 'threshold' mode keys: 'hard', 'alternating', 'gross'.
    'hard' = outside MIN_RR_MS–MAX_RR_MS or (2.4, 'kubios' mode) shorter than
    RR_REL_MIN_FRAC × the local rhythm [D19]. In 'kubios' mode (2.4) the
    interval after a premature beat that the classes left unflagged is added
    to 'ectopic' [D18]; neither rule relabels an interval already flagged.
    'alternating' (2.5) = a short–long alternation [D21]: with
    ALTERNATION_HANDLING = 'auto' or 'exclude' the whole stretch is flagged
    under this label (whether it is then corrected or left out is decided in
    the correction [D28]); with 'keep' every flag inside it except 'hard' is
    cleared.
    Morphology (per-PEAK) is handled separately at the call site."""
    _check_options()
    rr_ms = np.asarray(rr_ms, dtype=float)
    n = len(rr_ms)
    hard = (rr_ms < MIN_RR_MS) | (rr_ms > MAX_RR_MS) if n else np.zeros(n, dtype=bool)
    handling = ALTERNATION_HANDLING
    alt = _alternation_mask(rr_ms) if handling != 'off' else np.zeros(n, dtype=bool)
    exclude_alt = handling in ('auto', 'exclude') and bool(alt.any())  # flagged; [D28] decides the handling

    if DETECTION_METHOD == 'kubios' and n >= 4:
        masks = kubios_interval_masks(rr_ms)
        masks['alternating'] = alt if exclude_alt else np.zeros(n, dtype=bool)
        flag_early = EARLY_BEAT_HANDLING == 'flag'
        if RR_REL_MIN_FRAC or PREMATURE_MIN_FRAC or exclude_alt or flag_early:  # all off ⇒ the 2.3 detector
            flagged = hard.copy()
            for mk in masks.values():
                flagged |= mk
            if RR_REL_MIN_FRAC:  # [D19] spurious detections the pattern classes miss in noise
                rhythm = _local_rhythm(rr_ms, flagged)
                hard |= (rr_ms < RR_REL_MIN_FRAC * rhythm) & ~flagged   # adds flags, never relabels
                flagged |= hard
            if flag_early:  # [D24] option: late premature beats below the 20 % resolution
                early = _unflagged_early_mask(rr_ms, flagged)
                masks['ectopic'] = masks['ectopic'] | early
                flagged |= early
            if PREMATURE_MIN_FRAC:  # [D18] the interval after a premature beat
                _cur, nxt = _premature_beat_intervals(rr_ms, flagged, _local_rhythm(rr_ms, flagged))
                masks['ectopic'] = masks['ectopic'] | nxt  # nxt is unflagged so far: adds, never relabels
        out = {'hard': hard.copy()}
        used = hard.copy()
        for k in ('alternating', 'ectopic', 'missed', 'extra', 'longshort'):
            mk = masks[k] & ~used
            out[k] = mk
            used = used | mk
    else:
        lower, upper, _c = compute_rr_bounds(rr_ms)
        gross = ((rr_ms < lower) | (rr_ms > upper)) & ~hard if n >= 4 else np.zeros(n, dtype=bool)
        if EARLY_BEAT_HANDLING == 'flag' and n >= 5:  # [D24] option
            gross = gross | _unflagged_early_mask(rr_ms, hard | gross)
        out = {'hard': hard, 'alternating': (alt & ~hard) if exclude_alt else np.zeros(n, dtype=bool),
               'gross': gross & ~(alt if exclude_alt else np.zeros(n, dtype=bool))}
    if handling == 'keep' and alt.any():  # [D21] sensitivity option: the alternation is NN
        out = {k: (v if k == 'hard' else v & ~alt) for k, v in out.items()}
    return out


def flag_outliers_from_rr_ms(rr_ms):
    """Union of all per-reason masks — the interval-level outlier flag. Shared by
    the detector and the tachogram so what is drawn matches what is flagged."""
    out = np.zeros(len(rr_ms), dtype=bool)
    for mask in classify_rr_outlier_reasons(rr_ms).values():
        out |= mask
    return out


def detect_outlier_intervals(peak_indices, fs):
    if len(peak_indices) < 5:
        return np.zeros(max(0, len(peak_indices) - 1), dtype=bool), np.diff(peak_indices)
    rr = np.diff(peak_indices)
    rr_ms = rr / fs * 1000
    return flag_outliers_from_rr_ms(rr_ms), rr


def _interval_bad_mask(peak_indices, fs, ectopic_mask=None):
    is_out, rr = detect_outlier_intervals(peak_indices, fs)
    bad = is_out.copy()
    if ectopic_mask is not None and len(ectopic_mask) == len(peak_indices) and len(rr) > 0:
        em = np.asarray(ectopic_mask, dtype=bool)
        bad |= (em[:-1] | em[1:])
    return bad, rr


# ─────────────────────────────────────────────────────────────────────────────
# ARTIFACT CORRECTION
# ─────────────────────────────────────────────────────────────────────────────
def _interval_masks(peak_indices, fs, ectopic_mask=None, timing_bad=None):
    """(bad, timing_bad, rr): the interval-level flag used for correction
    (timing detector OR morphology, exactly as _interval_bad_mask) plus the
    timing-only part, so each run can be attributed to its source.
    `timing_bad` can be supplied pre-computed — process_trial() detects on the
    padded beat series so the window's edge beats have neighbours [D15]."""
    if timing_bad is not None and len(timing_bad) == len(peak_indices) - 1:
        timing_bad, rr = np.asarray(timing_bad, dtype=bool).copy(), np.diff(peak_indices)
    else:
        timing_bad, rr = detect_outlier_intervals(peak_indices, fs)
    bad = timing_bad.copy()
    if ectopic_mask is not None and len(ectopic_mask) == len(peak_indices) and len(rr) > 0:
        em = np.asarray(ectopic_mask, dtype=bool)
        bad |= (em[:-1] | em[1:])
    return bad, timing_bad, rr


def plan_correction_runs(peak_indices, fs, bad, excluded=None, recording_gap=None, early_beats=None):
    """Classify every maximal run of flagged intervals. Shared by
    perform_artifact_correction() and diagnose_gaps(), so the diagnostic can
    never disagree with what the correction does. (Logic unchanged from the
    previous version; it used to be duplicated in both functions.)

    For a run of L flagged intervals spanning `gap` samples:
      target = mean of the clean intervals bracketing the run (else the rolling
               median at the run start, else the median of all clean intervals)
      k      = max(1, round(gap / target))       expected physiologic intervals
      action = 'gap'      k − L > MAX_MISSED_BEATS, or (k − L ≥ 1 and gap longer
                          than MAX_GAP_RECONSTRUCT_SEC), or (k − L ≤ 0 and run
                          longer than MAX_REPLACE_RUN_SEC)
               'inserted' k > L and k ≥ 2   (missed beats)
               'merged'   k < L             (extra beats)
               'replaced' k == L            (right count, outlier values)
    A run containing any interval of `excluded` (a sustained alternation,
    [D21]) or of `recording_gap` (a hole in the ECG recording, [D26]) is 'gap'
    whatever its length. Every 'gap' run records why it was excluded
    ('exclusion_reason').
    `early_beats` [D28]: intervals of a SHORT alternation stretch (premature
    beats in bigeminy, to be corrected). Every early beat is a real beat, so
    those intervals keep their count: k = their number + round(rest / target)
    for the run's other flagged intervals. Otherwise early beats that reset
    the sinus node (a short + long pair spanning ~1.8 beats, P-001) add up to
    fewer whole beats than intervals and the run would be read as extra
    beats ('merged'), deleting real beats.
    Returns (runs, rr, local_median, global_med); rr in samples (float)."""
    peak_indices = np.asarray(peak_indices)
    bad = np.asarray(bad, dtype=bool)
    rr = np.diff(peak_indices).astype(float)
    n_rr = len(rr)
    local_median = (pd.Series(rr)
                    .rolling(window=MEDIAN_WINDOW, center=True, min_periods=1)
                    .median().values)
    global_med = float(np.median(rr[~bad])) if np.any(~bad) else float(np.median(rr))
    runs, j = [], 0
    while j < n_rr:
        if not bad[j]:
            j += 1
            continue
        run_s = j
        while j < n_rr and bad[j]:
            j += 1
        run_e = j  # one past the last bad interval
        L = run_e - run_s
        gap = float(peak_indices[run_e] - peak_indices[run_s])
        neigh = []
        if run_s - 1 >= 0 and not bad[run_s - 1]:
            neigh.append(rr[run_s - 1])
        if run_e < n_rr and not bad[run_e]:
            neigh.append(rr[run_e])
        if neigh:
            target = float(np.mean(neigh))
        elif local_median[run_s] > 0:
            target = float(local_median[run_s])
        else:
            target = global_med
        if target <= 0:
            target = global_med
        k = max(1, int(round(gap / target))) if target > 0 else 1
        eb = (np.asarray(early_beats[run_s:run_e], dtype=bool).copy() if early_beats is not None
              else np.zeros(L, dtype=bool))
        rr_run = rr[run_s:run_e]
        for a in np.where(eb)[0]:  # a beat split by an extra detection is not an early beat:
            if (eb[a] and a + 1 < L and eb[a + 1] and rr_run[a] + rr_run[a + 1] < 1.25 * target
                    and min(rr_run[a], rr_run[a + 1]) < 0.5 * target):
                eb[a] = eb[a + 1] = False  # … leave that pair to the count below
        n_early = int(np.sum(eb))
        if n_early and target > 0:  # [D28] the early beats' intervals keep their count
            rest = gap - float(np.sum(rr_run[eb]))
            k = max(1, n_early + int(round(max(rest, 0.0) / target)))
        beats_to_insert = k - L
        gap_sec = gap / fs
        reason = ''
        if recording_gap is not None and np.any(recording_gap[run_s:run_e]):
            reason = 'recording gap'
        elif excluded is not None and np.any(excluded[run_s:run_e]):
            reason = 'alternating rhythm'
        elif beats_to_insert > MAX_MISSED_BEATS:
            reason = f'more than {MAX_MISSED_BEATS} missed beats'
        elif beats_to_insert >= 1 and gap_sec > MAX_GAP_RECONSTRUCT_SEC:
            reason = f'missed beats over more than {MAX_GAP_RECONSTRUCT_SEC:g} s'
        elif beats_to_insert <= 0 and gap_sec > MAX_REPLACE_RUN_SEC:
            reason = f'flagged stretch longer than {MAX_REPLACE_RUN_SEC:g} s'
        if reason:
            action = 'gap'
        elif k > L and k >= 2:
            action = 'inserted'
        elif k < L:
            action = 'merged'
        else:
            action = 'replaced'
        runs.append({'run_s': run_s, 'run_e': run_e, 'L': L, 'k': k, 'gap': gap,
                     'target': target, 'beats_to_insert': beats_to_insert,
                     'span_sec': gap_sec, 'action': action, 'exclusion_reason': reason,
                     'early_beats': n_early})
    return runs, rr, local_median, global_med


def _gpr_kernel():
    """[D1] GP covariance. Hyperparameters are re-estimated for every fit by
    maximum marginal likelihood; the bounds are wide and only exclude
    degenerate solutions. normalize_y=True, so variances are relative to the
    variance of the clean RR intervals being fitted."""
    if GPR_KERNEL == 'rq':
        return (ConstantKernel(1.0, (1e-3, 1e3))
                * RationalQuadratic(length_scale=3.0, alpha=1.0,
                                    length_scale_bounds=(0.1, 1e3), alpha_bounds=(1e-3, 1e3))
                + WhiteKernel(noise_level=0.1, noise_level_bounds=(1e-5, 1e1)))
    if GPR_KERNEL == 'rbf':  # previous kernel — kept only for sensitivity analyses
        return 1.0 * RBF(length_scale=10.0) + WhiteKernel(noise_level=1.0)
    raise ValueError(f"GPR_KERNEL must be 'rq' or 'rbf', got {GPR_KERNEL!r}")


def _gpr_fit_predict(x_train, y_train, x_query):
    """Fit ONE GP on (beat position, RR) of clean intervals and predict every
    query position in a single vectorised call ([D3]). Seeded restarts make the
    fit reproducible ([D4]). Returns (mean, sd, description); mean/sd are None
    when there are too few clean intervals or the fit fails, in which case the
    caller falls back to equal division / local median."""
    x_train = np.asarray(x_train, dtype=float)
    x_query = np.asarray(x_query, dtype=float)
    if len(x_train) < GPR_MIN_TRAIN or len(x_query) == 0:
        return None, None, f'no GP (fewer than {GPR_MIN_TRAIN} clean intervals)'
    try:
        gp = GaussianProcessRegressor(kernel=_gpr_kernel(), normalize_y=True,
                                      n_restarts_optimizer=GPR_N_RESTARTS,
                                      random_state=GPR_RANDOM_STATE)
        with warnings.catch_warnings():
            warnings.simplefilter('ignore', ConvergenceWarning)
            gp.fit(x_train.reshape(-1, 1), np.asarray(y_train, dtype=float))
        mean, sd = gp.predict(x_query.reshape(-1, 1), return_std=True)
        return np.asarray(mean, dtype=float), np.asarray(sd, dtype=float), str(gp.kernel_)
    except Exception as e:  # numerical failure → documented fallback, never a crash
        print(f"  ⚠ GPR fit failed ({e}); equal division / local median used instead")
        return None, None, f'GP fit failed: {e}'


def perform_artifact_correction(peak_indices, fs, combined_bad_mask=None, timing_bad=None, alternating=None,
                                recording_gap=None, alternating_sustained=None):
    """Reconstruct an RR series from detected peaks. Run classification is
    unchanged (see plan_correction_runs); what changed is how VALUES are filled
    and where the reconstructed beats are placed:

      • 'kept'     clean interval, untouched.
      • 'gap'      unrecoverable: ONE interval spanning the gap, FLAGGED, and
                   excluded downstream (no fabrication).
      • 'inserted' / 'merged' (k ≥ 2) / 'replaced' (L ≥ 2): the run is filled
                   with k intervals [D2]. Their BEATS are placed so the run tiles
                   the observed gap exactly (GP posterior mean as the shape + an
                   equal share of the residual gap − Σ shape), so there is one
                   monotone timeline. Their VALUES depend on what the run is:
                   - 'inserted' (missed beats) and 'merged' (extra beats) are
                     DETECTION errors — the heart's beat times are unaffected, so
                     the k true intervals must fill the gap: values = spacings,
                     provided the gap holds k beats at the local rhythm
                     (|gap/k − rhythm| ≤ RR_SUM_MAX_OFFSET·rhythm, rhythm = mean GP
                     estimate over the run, else the rolling median). If not, the
                     beat count itself is in doubt, so the values stay at the
                     local rhythm and the run is labelled 'ambiguous' in QC.
                   - 'replaced' runs are RHYTHM events (premature beats, timing
                     noise); a premature beat can reset the sinus node, so the
                     gap need not equal k sinus cycles: values = GP estimate of
                     the local sinus RR (not forced to sum to the gap).
                   RR_SUM_CONSTRAINT = 'all' / 'none' applies one rule to every
                   run (sensitivity analyses). Any value outside [max(MIN_RR,
                   0.5·target), min(MAX_RR, 1.5·target)], or no GP available ⇒
                   equal beats, value gap/k (sum-constrained) or RR_local.
      • 'merged' with k == 1: one interval equal to the observed gap.
      • 'replaced' with L == k == 1: both bounding beats are real, so only the
                   VALUE is substituted (GP mean, or the local median if the GP
                   value is implausible/unavailable — same guard as before) and
                   the beat times are kept.

    GP inputs [D8]: clean intervals are placed on an estimated beat-order axis
    (+1 per clean interval, +k per flagged run, including unrecoverable gaps),
    i.e. 'indices of RR intervals following a temporal order' (Mojtahed et al.
    2026, Sec. 3.3) counted in physiologic beats rather than detected ones.

    Returns a dict:
      bad               (m,)    bool   flagged intervals (timing OR morphology)
      timing_bad        (m,)    bool   timing-detector part of `bad`
      peak_outlier_mask (n,)    bool   flagged peaks, ORIGINAL index space (both
                                       beats of every flagged interval; burden)
      corrected_beat_mask (n,)  bool   beats the correction moved or removed
                                       (interior beats of runs)
      corrected_rr      (m',)   float  corrected RR series (samples). For
                                       synthesised intervals this is the value
                                       estimate; for 'replaced' runs (and lone
                                       replaced intervals) it need not equal the
                                       beat spacing.
      reconstructed     (m'+1,) float  reconstructed R-peak positions (samples);
                                       endpoints and all clean beats preserved
      gap_mask          (m',)   bool   True on unrecoverable gaps
      corrected_type    (m',)   <U8    kept/replaced/inserted/merged/gap
      posterior_sd      (m',)   float  GP posterior SD (samples) where a GP value
                                       was used, NaN elsewhere
      runs              list of dicts: the plan plus how each run was filled
      gpr_fit           str     fitted kernel(s) or why no GP was used
      beat_fate         (n,)    <U8    per detected beat: 'clean', 'kept' (flagged
                                       but left in place), 'moved' (re-timed, or
                                       removed as an extra beat) or 'excluded'
      breakdown         dict    the flagged beats split by what happened to them
                                       ([D23]; see _beat_breakdown)
    `alternating` (m,) bool: intervals in an alternation stretch [D21], and
    `alternating_sustained` (m,) bool: those of them in sustained stretches
    [D28]; process_trial() passes both from the padded beat series, otherwise
    they are computed here. With ALTERNATION_HANDLING = 'auto', sustained
    stretches are excluded and short ones corrected with their beats kept.
    `recording_gap` (m,) bool: intervals spanning a hole in the ECG recording
    [D26] (process_trial() passes it). They are flagged and their run is
    excluded ('recording gap'), so nothing is inserted across the hole.
    """
    if RR_SUM_CONSTRAINT not in ('detection', 'all', 'none'):
        raise ValueError(f"RR_SUM_CONSTRAINT must be 'detection', 'all' or 'none', got {RR_SUM_CONSTRAINT!r}")
    _check_options()
    peak_indices = np.asarray(peak_indices)
    n = len(peak_indices)
    if n < 5:
        rr0 = np.diff(peak_indices).astype(float)
        m0 = len(rr0)
        return {'bad': np.zeros(m0, dtype=bool), 'timing_bad': np.zeros(m0, dtype=bool),
                'peak_outlier_mask': np.zeros(n, dtype=bool),
                'corrected_beat_mask': np.zeros(n, dtype=bool), 'corrected_rr': rr0,
                'reconstructed': peak_indices.astype(float), 'gap_mask': np.zeros(m0, dtype=bool),
                'corrected_type': np.array(['kept'] * m0, dtype='<U8'),
                'posterior_sd': np.full(m0, np.nan), 'runs': [], 'gpr_fit': 'not run (<5 peaks)',
                'beat_fate': np.array(['clean'] * n, dtype='<U8'),
                'breakdown': _beat_breakdown(n, [], np.zeros(n, dtype=bool), np.zeros(m0, dtype=bool))}

    bad, timing_bad, _rr = _interval_masks(peak_indices, fs, combined_bad_mask, timing_bad)
    if alternating is None or len(alternating) != n - 1:
        alternating = _alternation_mask(np.diff(peak_indices) / fs * 1000.0)
        alternating_sustained = None
    alternating = np.asarray(alternating, dtype=bool)
    if alternating_sustained is None or len(alternating_sustained) != n - 1:
        alternating_sustained = _alternation_sustained(np.diff(peak_indices) / fs * 1000.0, alternating)
    alternating_sustained = np.asarray(alternating_sustained, dtype=bool) & alternating
    if ALTERNATION_HANDLING == 'exclude':
        alt_excl, alt_keep = alternating, None
    elif ALTERNATION_HANDLING == 'auto':  # [D28]
        alt_excl, alt_keep = alternating_sustained, alternating & ~alternating_sustained
    else:
        alt_excl = alt_keep = None
    rec_gap = (np.asarray(recording_gap, dtype=bool)
               if recording_gap is not None and len(recording_gap) == n - 1 and RECORDING_GAP_HANDLING == 'exclude'
               else np.zeros(n - 1, dtype=bool))
    if rec_gap.any():  # [D26] an interval across a recording hole is never a heartbeat interval
        bad = bad | rec_gap
        timing_bad = timing_bad | rec_gap
    runs, rr, local_median, global_med = plan_correction_runs(
        peak_indices, fs, bad, excluded=(alt_excl & bad) if alt_excl is not None else None,
        recording_gap=rec_gap, early_beats=(alt_keep & bad) if alt_keep is not None else None)
    n_rr = len(rr)

    # ── [D8] beat-order axis ────────────────────────────────────────────────
    pos = np.full(n_rr, np.nan)
    run_pos, p, j, r_i = [], 0.0, 0, 0
    while j < n_rr:
        if not bad[j]:
            pos[j] = p
            p += 1.0
            j += 1
            continue
        run = runs[r_i]
        run_pos.append(p + np.arange(run['k'], dtype=float))
        p += run['k']
        j = run['run_e']
        r_i += 1
    clean_idx = np.where(~bad)[0]
    x_clean, y_clean = pos[clean_idx], rr[clean_idx]

    # ── GP (one fit per trial): only runs whose values are synthesised need it ──
    needs_gp = [i for i, r in enumerate(runs)
                if r['action'] in ('inserted', 'replaced')
                or (r['action'] == 'merged' and r['k'] >= 2)]
    gp_mean, gp_sd = {}, {}
    gpr_fit = 'not needed (no synthesised intervals)'
    if needs_gp and RR_FILL_METHOD == 'gpr':
        xq = np.concatenate([run_pos[i] for i in needs_gp])
        mean, sd, gpr_fit = _gpr_fit_predict(x_clean, y_clean, xq)   # one fit, one predict
        if mean is not None:
            o = 0
            for i in needs_gp:
                nq = len(run_pos[i])
                gp_mean[i], gp_sd[i] = mean[o:o + nq], sd[o:o + nq]
                o += nq
    elif needs_gp and RR_FILL_METHOD == 'equal':
        gpr_fit = "not used (RR_FILL_METHOD = 'equal')"
    elif needs_gp:
        raise ValueError(f"RR_FILL_METHOD must be 'gpr' or 'equal', got {RR_FILL_METHOD!r}")

    # ── fill ────────────────────────────────────────────────────────────────
    min_rr_s, max_rr_s = MIN_RR_MS / 1000.0 * fs, MAX_RR_MS / 1000.0 * fs
    corrected, types, ends, gap_flags, sds = [], [], [], [], []
    j, r_i = 0, 0
    while j < n_rr:
        if not bad[j]:
            corrected.append(rr[j])
            types.append('kept')
            ends.append(float(peak_indices[j + 1]))
            gap_flags.append(False)
            sds.append(np.nan)
            j += 1
            continue
        run = runs[r_i]
        run_s, run_e, L, k = run['run_s'], run['run_e'], run['L'], run['k']
        gap, target, action = run['gap'], run['target'], run['action']
        start_s, end_s = float(peak_indices[run_s]), float(peak_indices[run_e])
        n_morph = int(np.sum(bad[run_s:run_e] & ~timing_bad[run_s:run_e]))
        run['out_start'] = len(corrected)  # index of the run's first output interval
        run.update(timing_flagged=L - n_morph, morphology_only=n_morph, count_fit_offset=np.nan,
                   posterior_sd_mean=np.nan, gap_to_rr_ratio=gap / target if target > 0 else np.nan)

        if action == 'gap':
            corrected.append(gap)
            types.append('gap')
            ends.append(end_s)
            gap_flags.append(True)
            sds.append(np.nan)
            run['values_from'] = f"not reconstructed (excluded: {run.get('exclusion_reason') or 'unrecoverable'})"

        elif action == 'merged' and k == 1:
            corrected.append(gap)
            types.append('merged')
            ends.append(end_s)
            gap_flags.append(False)
            sds.append(np.nan)
            run['values_from'] = 'observed gap (extra beat removed)'

        elif action == 'replaced' and L == 1:
            lm = float(local_median[run_s]) if local_median[run_s] > 0 else target
            val, sdv, src = lm, np.nan, 'local median'
            if r_i in gp_mean:
                cand = float(gp_mean[r_i][0])
                lo, hi = max(min_rr_s, 0.5 * lm), min(max_rr_s, 1.5 * lm)
                if np.isfinite(cand) and lo <= cand <= hi:
                    val, sdv, src = cand, float(gp_sd[r_i][0]), 'GPR'
            corrected.append(val)
            types.append('replaced')
            ends.append(end_s)
            gap_flags.append(False)
            sds.append(sdv)
            run['values_from'] = src + ' (value substituted, beat times kept)'
            run['posterior_sd_mean'] = sdv

        else:  # inserted, merged (k ≥ 2), replaced (L ≥ 2)
            # Beat POSITIONS always tile the gap (shape + equal share of residual).
            # VALUES equal those spacings (sum-constrained) for detection errors,
            # and stay at the predicted local rhythm for rhythm events [D2].
            # Does the gap hold a whole number of beats at the LOCAL RHYTHM? The
            # rhythm is the GP estimate over the run (else the rolling median),
            # not `target`, which one undetected premature neighbour can skew.
            level = (float(np.mean(gp_mean[r_i])) if r_i in gp_mean
                     else float(local_median[run_s]) if local_median[run_s] > 0 else target)
            offset = abs(gap / k - level) / level if level > 0 else np.inf
            run['count_fit_offset'] = offset
            sum_here = (RR_SUM_CONSTRAINT == 'all'
                        or (RR_SUM_CONSTRAINT == 'detection' and action in ('inserted', 'merged')
                            and offset <= RR_SUM_MAX_OFFSET))
            lo, hi = max(min_rr_s, 0.5 * target), min(max_rr_s, 1.5 * target)
            spacing = np.full(k, gap / k)
            vals = spacing.copy() if sum_here else np.full(k, target)
            sdv = np.full(k, np.nan)
            src = 'equal division' if sum_here else 'RR_local (values only)'
            if r_i in gp_mean:
                shape = gp_mean[r_i]
                cand = shape + (gap - shape.sum()) / k
                use = cand if sum_here else shape
                if (np.all(np.isfinite(cand)) and np.all((cand >= lo) & (cand <= hi))
                        and np.all((use >= lo) & (use <= hi))):
                    spacing, vals, sdv = cand, use.copy(), gp_sd[r_i]
                    src = 'GPR (sum-constrained)' if sum_here else 'GPR (values only)'
            if (RR_SUM_CONSTRAINT == 'detection' and action in ('inserted', 'merged')
                    and not sum_here):
                src += f' — beat count ambiguous: gap/k is {100 * offset:.0f} % from the local rhythm'
            run_ends = start_s + np.cumsum(spacing)
            run_ends[-1] = end_s  # exact endpoint, no floating drift
            for v, e, s in zip(vals, run_ends, sdv):
                corrected.append(float(v))
                types.append(action)
                ends.append(float(e))
                gap_flags.append(False)
                sds.append(float(s))
            run['values_from'] = src
            run['posterior_sd_mean'] = float(np.nanmean(sdv)) if np.any(np.isfinite(sdv)) else np.nan
        run['n_out'] = len(corrected) - run['out_start']
        j = run_e
        r_i += 1

    for run in runs:  # [D28] say so in Reconstruction_QC
        if run.get('early_beats') and run['action'] != 'gap':
            run['values_from'] = (run.get('values_from') or '') + \
                f" — {run['early_beats']} intervals of a short alternating stretch: early beats kept and re-timed [D28]"
    reconstructed = np.concatenate([[float(peak_indices[0])], np.asarray(ends, dtype=float)])
    reconstructed = np.maximum.accumulate(reconstructed)  # numerical safety (no-op normally)

    peak_outlier_mask = np.zeros(n, dtype=bool)
    peak_outlier_mask[:-1] |= bad
    peak_outlier_mask[1:] |= bad
    peak_outlier_mask[0] = peak_outlier_mask[-1] = False
    # Beats the correction actually moved or removed: the INTERIOR beats of each
    # run (its two boundary beats are kept). Used by the dashboard markers;
    # peak_outlier_mask (which also counts boundary beats) stays the burden flag.
    corrected_beat_mask = np.zeros(n, dtype=bool)
    for run in runs:
        corrected_beat_mask[run['run_s'] + 1:run['run_e']] = True
    # [D23] what happened to each flagged beat (the workbook's Unique_Bad_Beats =
    # beats touching a flagged interval OR with an abnormal shape)
    em = (np.asarray(combined_bad_mask, dtype=bool) if combined_bad_mask is not None
          and len(combined_bad_mask) == n else np.zeros(n, dtype=bool))
    unique_bad = peak_outlier_mask | em
    beat_fate = np.where(unique_bad, 'kept', 'clean').astype('<U8')
    for run in runs:
        beat_fate[run['run_s'] + 1:run['run_e']] = 'excluded' if run['action'] == 'gap' else 'moved'
    return {'bad': bad, 'timing_bad': timing_bad, 'peak_outlier_mask': peak_outlier_mask,
            'corrected_beat_mask': corrected_beat_mask,
            'corrected_rr': np.asarray(corrected, dtype=float), 'reconstructed': reconstructed,
            'gap_mask': np.asarray(gap_flags, dtype=bool),
            'corrected_type': np.asarray(types, dtype='<U8'),
            'posterior_sd': np.asarray(sds, dtype=float), 'runs': runs, 'gpr_fit': gpr_fit,
            'beat_fate': beat_fate,
            'breakdown': _beat_breakdown(n, runs, unique_bad, alternating, early_kept=alt_keep,
                                         unflagged_early=_unflagged_early_mask(
                                             np.diff(peak_indices) / fs * 1000.0, bad))}


def _unflagged_early_mask(rr_ms, bad):
    """[D24] Quality check, flags nothing: unflagged intervals at least
    (1 − EARLY_CHECK_FRAC) shorter than the local median of 9 intervals, with
    both neighbours ≥ 95 % of it — one slightly early beat followed by a
    return to the rhythm, the signature of a late premature beat that the
    detector (20 % resolution, [D16]) cannot see. Breathing changes the RR over
    several beats, not one."""
    rr_ms = np.asarray(rr_ms, dtype=float)
    n = len(rr_ms)
    out = np.zeros(n, dtype=bool)
    if n < 5 or not EARLY_CHECK_FRAC:
        return out
    loc = pd.Series(rr_ms).rolling(9, center=True, min_periods=5).median().to_numpy()
    c = loc[1:-1]
    out[1:-1] = ((rr_ms[1:-1] < EARLY_CHECK_FRAC * c) & (rr_ms[:-2] >= 0.95 * c) & (rr_ms[2:] >= 0.95 * c))
    return out & ~np.asarray(bad, dtype=bool)


def _beat_breakdown(n, runs, unique_bad, alternating, unflagged_early=None, early_kept=None):
    """[D23] The flagged ('bad') beats split by what the correction did with
    them. A bad beat is either INSIDE a flagged run (both of its intervals
    flagged) or one of the two real beats that bound a run.
      dropped   — taken out of the beat series: extra beats removed (L − k of a
                  merged run's L − 1 inner beats) and the inner beats of a
                  stretch excluded from analysis ('gap' runs: too long,
                  too many missed beats, alternating rhythm [D21]).
      corrected — kept as a beat but moved to the reconstructed position (the
                  inner beats of replaced / inserted runs, k − 1 of a merged run).
      kept      — left exactly where they were: the beats that bound each run
                  (and both beats of a single interval whose value was replaced).
    Beats INSERTED for missed beats were never detected, so they are counted
    separately and are not part of Unique_Bad_Beats.
    unique_bad = dropped + corrected + kept. Also writes the per-run counts into
    each run (Reconstruction_QC). corrected_alternating [D28]: of the corrected
    beats, those ending an interval of a short alternation stretch (`early_kept`)."""
    unique_bad = np.asarray(unique_bad, dtype=bool)
    ek = np.asarray(early_kept, dtype=bool) if early_kept is not None else None
    d_extra = d_excl = d_alt = corrected = inserted = kept_runs = c_alt = 0
    for r in runs:
        L, k = r['L'], r['k']
        inner = max(0, L - 1)
        if r['action'] == 'gap':
            d, c, i = inner, 0, 0
            d_excl += inner
            if r.get('exclusion_reason') == 'alternating rhythm':
                d_alt += inner
        elif r['action'] == 'merged':
            d, c, i = L - k, k - 1, 0
            d_extra += L - k
        elif r['action'] == 'inserted':
            d, c, i = 0, inner, k - L
        else:  # replaced
            d, c, i = 0, inner, 0
        corrected += c
        inserted += i
        if ek is not None and r['action'] != 'gap' and len(ek):
            c_alt += int(np.sum(ek[r['run_s']:max(r['run_s'], r['run_e'] - 1)]))
        kb = int(unique_bad[r['run_s']]) + int(unique_bad[r['run_e']]) if n else 0
        kept_runs += kb
        r.update(beats_dropped=d, beats_corrected=c, beats_inserted=i, bad_beats_kept=kb)
    n_bad = int(np.sum(unique_bad))
    dropped = d_extra + d_excl
    alternating = np.asarray(alternating, dtype=bool)
    ue = np.asarray(unflagged_early if unflagged_early is not None else np.zeros(len(alternating)), dtype=bool)
    return {'unique_bad': n_bad, 'dropped': dropped, 'dropped_extra': d_extra, 'dropped_excluded': d_excl,
            'excluded_alternating': d_alt, 'corrected': corrected, 'corrected_alternating': c_alt,
            'inserted': inserted,
            'kept': n_bad - dropped - corrected, 'kept_check': kept_runs,
            'alternating_pct': float(100.0 * alternating.mean()) if len(alternating) else 0.0,
            'unflagged_early_pct': float(100.0 * ue.mean()) if len(ue) else 0.0}


def diagnose_gaps(peak_indices, fs, ectopic_mask=None, verbose=True, timing_bad=None, alternating=None,
                  recording_gap=None, alternating_sustained=None):
    """Explain every flagged run and WHY it was classified as it was — the tool
    to run when 'unrecoverable gap' shows up and you want to know the cause.

    For each maximal run of flagged intervals it reports: the span (s), L (number
    of flagged intervals), k (expected physiologic intervals), beats_to_insert
    (k−L), the resulting action (gap/inserted/merged/replaced), and how many of
    the run's flagged intervals came from TIMING (RR outlier) vs MORPHOLOGY-only
    (present beat, abnormal shape) — so you can tell whether gaps are real
    dropouts or the morphology detector condemning a noisy-but-present stretch.
    Uses the same plan_correction_runs() as the correction itself.

    Returns a list of dicts (one per run)."""
    peak_indices = np.asarray(peak_indices)
    bad, timing_bad, _rr = _interval_masks(peak_indices, fs, ectopic_mask, timing_bad)
    morph_only = bad & ~timing_bad
    # pass `alternating` (and `timing_bad`) from the padded series, as process_trial
    # does for the correction, or the plan can differ at the window's edges
    given = alternating is not None and len(alternating) == len(bad)
    alt = (np.asarray(alternating, dtype=bool) if given
           else _alternation_mask(np.diff(peak_indices) / fs * 1000.0))
    sus = (np.asarray(alternating_sustained, dtype=bool)
           if given and alternating_sustained is not None and len(alternating_sustained) == len(bad)
           else _alternation_sustained(np.diff(peak_indices) / fs * 1000.0, alt)) & alt
    if ALTERNATION_HANDLING == 'exclude':  # as in perform_artifact_correction [D28]
        alt_excl, alt_keep = alt, None
    elif ALTERNATION_HANDLING == 'auto':
        alt_excl, alt_keep = sus, alt & ~sus
    else:
        alt_excl = alt_keep = None
    rg = (np.asarray(recording_gap, dtype=bool)
          if recording_gap is not None and len(recording_gap) == len(bad) and RECORDING_GAP_HANDLING == 'exclude'
          else np.zeros(len(bad), dtype=bool))
    bad = bad | rg  # [D26] as in perform_artifact_correction
    timing_bad = timing_bad | rg
    morph_only = bad & ~timing_bad
    plan, *_ = plan_correction_runs(peak_indices, fs, bad,
                                    excluded=(alt_excl & bad) if alt_excl is not None else None,
                                    recording_gap=rg,
                                    early_beats=(alt_keep & bad) if alt_keep is not None else None)
    runs = []
    for r in plan:
        n_morph = int(np.sum(morph_only[r['run_s']:r['run_e']]))
        runs.append({'start_interval': r['run_s'], 'L': r['L'], 'span_sec': round(r['span_sec'], 2),
                     'k': r['k'], 'beats_to_insert': r['beats_to_insert'], 'action': r['action'],
                     'exclusion_reason': r['exclusion_reason'],
                     'timing_flagged': r['L'] - n_morph, 'morphology_only': n_morph})
    if verbose:
        gaps = [r for r in runs if r['action'] == 'gap']
        print(f"  {len(runs)} flagged run(s); {len(gaps)} → unrecoverable gap")
        for r in gaps:
            src = ("morphology-driven" if r['morphology_only'] >= r['timing_flagged']
                   else "timing-driven")
            print(f"    gap @interval {r['start_interval']}: L={r['L']} span={r['span_sec']}s "
                  f"k={r['k']} insert={r['beats_to_insert']} ({r['exclusion_reason']}) "
                  f"[{r['timing_flagged']} timing / {r['morphology_only']} morph-only → {src}]")
    return runs


# ─────────────────────────────────────────────────────────────────────────────
# HRV METRICS
# ─────────────────────────────────────────────────────────────────────────────
def calculate_time_domain_hrv(rr_ms, contiguous=None):
    """Time-domain metrics. `contiguous` (len(rr_ms) − 1, bool): which successive
    differences join two ADJACENT intervals; a difference spanning a stretch
    excluded from the series is not a successive difference and is left out
    of RMSSD, SDSD and pNN50 [D22]. None ⇒ every difference counts."""
    nan = float('nan')
    if len(rr_ms) < 5:
        # [D17] Not computable → NaN (an empty cell in the workbook, NA in R). This used
        # to return 0, which reads as a real HR / SDNN / RMSSD of zero.
        return {'HR': nan, 'SDNN': nan, 'RMSSD': nan, 'SDSD': nan, 'pNN50': nan, 'NN_count': len(rr_ms)}
    rr_ms = np.asarray(rr_ms, dtype=float)
    diff_rr = np.diff(rr_ms)
    if contiguous is not None:
        if len(contiguous) != len(diff_rr):
            raise ValueError(f"contiguous has {len(contiguous)} entries, expected {len(diff_rr)}")
        diff_rr = diff_rr[np.asarray(contiguous, dtype=bool)]
    out = {'HR': 60000 / np.mean(rr_ms), 'SDNN': np.std(rr_ms, ddof=1),
           'RMSSD': nan, 'SDSD': nan, 'pNN50': nan, 'NN_count': len(rr_ms)}
    if len(diff_rr) >= 4:  # [D17]: the same minimum as above, in differences
        out.update(RMSSD=np.sqrt(np.mean(diff_rr ** 2)), SDSD=np.std(diff_rr, ddof=1),
                   pNN50=np.sum(np.abs(diff_rr) > 50) / len(diff_rr) * 100)
    return out


def get_peak_frequency(f, psd, low, high):
    mask = (f >= low) & (f < high)
    return float(f[mask][np.argmax(psd[mask])]) if np.any(mask) else 0.0


def calculate_lomb_scargle_psd(rr_times_sec, rr_ms):
    _empty = {'LF': 0, 'HF': 0, 'LF/HF': 0, 'Total_Power': 0, 'VLF': 0, 'method': 'lomb-scargle'}
    if len(rr_ms) < 10:
        return {**_empty, 'quality': 'insufficient_data'}
    duration = rr_times_sec[-1] - rr_times_sec[0]
    if duration < MIN_SEGMENT_DURATION:
        return {**_empty, 'quality': 'insufficient_duration', 'duration_sec': duration}
    rr_detrended = detrend(rr_ms, type='linear')
    frequencies = np.linspace(0.0001, 0.5, 4096)
    pgram = lombscargle(rr_times_sec, rr_detrended, 2 * np.pi * frequencies, normalize=False)
    area = float(_trapz(pgram, frequencies))
    psd = pgram * ((np.var(rr_detrended) / area) if area > 0 else 0.0)

    def band_power(lo, hi):
        m = (frequencies >= lo) & (frequencies < hi)
        return float(_trapz(psd[m], frequencies[m]))

    vlf, lf, hf = band_power(0.003, 0.04), band_power(0.04, 0.15), band_power(0.15, 0.40)
    tot = band_power(0.003, 0.40)
    lhfs = lf + hf
    return {
        'VLF': vlf, 'LF': lf, 'HF': hf, 'Total_Power': tot,
        'VLF_peak': get_peak_frequency(frequencies, psd, 0.003, 0.04),
        'LF_peak': get_peak_frequency(frequencies, psd, 0.04, 0.15),
        'HF_peak': get_peak_frequency(frequencies, psd, 0.15, 0.40),
        'LF/HF': lf / hf if hf > 0 else 0,
        'LF_nu': lf / lhfs * 100 if lhfs > 0 else 0,
        'HF_nu': hf / lhfs * 100 if lhfs > 0 else 0,
        'VLF_rel': vlf / tot * 100 if tot > 0 else 0,
        'LF_rel': lf / tot * 100 if tot > 0 else 0,
        'HF_rel': hf / tot * 100 if tot > 0 else 0,
        'method': 'lomb-scargle', 'quality': 'good',
        'duration_sec': duration, 'n_intervals': len(rr_ms),
        'frequencies': frequencies, 'psd': psd,
    }


def calculate_welch_psd(rr_ms, rr_times_sec=None):
    _empty = {'LF': 0, 'HF': 0, 'LF/HF': 0, 'Total_Power': 0, 'VLF': 0, 'method': 'welch'}
    if len(rr_ms) < 30:
        return {**_empty, 'quality': 'insufficient_data'}
    if rr_times_sec is not None and len(rr_times_sec) == len(rr_ms):
        rr_times = np.asarray(rr_times_sec, dtype=float) - np.asarray(rr_times_sec, dtype=float)[0]
    else:
        rr_times = np.cumsum(rr_ms) / 1000
        rr_times -= rr_times[0]
    if rr_times[-1] < MIN_SEGMENT_DURATION:
        return {**_empty, 'quality': 'insufficient_duration'}
    fs_interp = 4.0
    time_grid = np.arange(0, rr_times[-1], 1 / fs_interp)
    if len(time_grid) < 10:
        return {**_empty, 'quality': 'insufficient_data'}
    rr_interp = interp1d(rr_times, rr_ms, kind='cubic', fill_value="extrapolate")(time_grid)
    rr_det = detrend(rr_interp, type='linear')
    nperseg = 256
    f, Pxx = welch(rr_det, fs=fs_interp, nperseg=nperseg,
                   noverlap=nperseg // 2, window='hann', scaling='density', detrend=False)

    def band_power(lo, hi):
        m = (f >= lo) & (f < hi)
        return float(_trapz(Pxx[m], f[m]))

    # band edges identical to Lomb–Scargle so the two estimates are comparable
    vlf, lf, hf = band_power(0.003, 0.04), band_power(0.04, 0.15), band_power(0.15, 0.40)
    tot = band_power(0.003, 0.40)
    lhfs = lf + hf
    return {
        'VLF': vlf, 'LF': lf, 'HF': hf, 'Total_Power': tot,
        'VLF_peak': get_peak_frequency(f, Pxx, 0.003, 0.04),
        'LF_peak': get_peak_frequency(f, Pxx, 0.04, 0.15),
        'HF_peak': get_peak_frequency(f, Pxx, 0.15, 0.40),
        'LF/HF': lf / hf if hf > 0 else 0,
        'LF_nu': lf / lhfs * 100 if lhfs > 0 else 0,
        'HF_nu': hf / lhfs * 100 if lhfs > 0 else 0,
        'VLF_rel': vlf / tot * 100 if tot > 0 else 0,
        'LF_rel': lf / tot * 100 if tot > 0 else 0,
        'HF_rel': hf / tot * 100 if tot > 0 else 0,
        'method': 'welch', 'quality': 'good',
        'frequencies': f, 'psd': Pxx,
    }


# ─────────────────────────────────────────────────────────────────────────────
# VALIDATION BENCHMARK — Lipponen–Tarvainen (2019) / Kubios
# Cross-checks the custom correction against a published reference method and
# scores agreement against BENCHMARK_TOLERANCES (PASS / WARN / FAIL).
# ─────────────────────────────────────────────────────────────────────────────
def benchmark_against_kubios(peak_indices, fs):
    """Run the Kubios artifact-correction reference on the same peaks and return
    its HRV metrics, the corrected peak positions, the artifact-category dict,
    and the inserted/removed beat classification (or None on failure)."""
    if len(peak_indices) < 10:
        return None
    try:
        orig = np.asarray(peak_indices, dtype=int)
        artifacts, corrected_peaks = nk.signal_fixpeaks(
            orig, sampling_rate=fs, method="kubios")
        corrected_peaks = np.asarray(corrected_peaks, dtype=float)
        if len(corrected_peaks) < 5:
            return None
        rr_ms = np.diff(corrected_peaks) / fs * 1000
        rr_times = np.cumsum(rr_ms) / 1000
        rr_times -= rr_times[0]
        # NeuroKit's category dict can be sparse; the robust signal of "what
        # Kubios changed" is the diff between the original and corrected peaks.
        inserted, removed = _classify_kubios_edits(orig, corrected_peaks, fs)
        cats = {k: np.asarray(artifacts.get(k, []), dtype=int).tolist()
                for k in ('ectopic', 'missed', 'extra', 'longshort')}
        return {
            'time': calculate_time_domain_hrv(rr_ms),
            'freq': calculate_lomb_scargle_psd(rr_times, rr_ms),
            'n_peaks': int(len(corrected_peaks)),
            'corrected_peaks': corrected_peaks,  # sample indices (signal space)
            'inserted_peaks': inserted,  # sample indices Kubios added
            'removed_peaks': removed,  # sample indices Kubios deleted
            'categories': cats,  # beat-index lists, when present
        }
    except Exception as e:
        print(f"  ⚠ Kubios benchmark failed: {e}")
        return None


def _classify_kubios_edits(orig_idx, kubios_idx, fs, tol_sec=0.075):
    """Merge-diff two peak-index arrays. Returns (inserted, removed) in sample
    space: peaks present only in the Kubios output (inserted / missed-beat
    corrections) and peaks present only in the original (removed / extra-beat
    corrections). A match tolerance of tol_sec absorbs sub-beat repositioning."""
    orig = np.sort(np.asarray(orig_idx, dtype=float))
    kub = np.sort(np.asarray(kubios_idx, dtype=float))
    tol = tol_sec * fs
    inserted, removed = [], []
    i = j = 0
    while i < len(orig) and j < len(kub):
        d = kub[j] - orig[i]
        if abs(d) <= tol:
            i += 1;
            j += 1
        elif d < 0:
            inserted.append(kub[j]);
            j += 1
        else:
            removed.append(orig[i]);
            i += 1
    removed.extend(orig[i:].tolist())
    inserted.extend(kub[j:].tolist())
    return np.array(inserted), np.array(removed)


def _agreement(custom, reference, rel_tol):
    """Relative-difference verdict for one metric. Returns 'n/a' when the
    reference is missing, zero, or non-finite (avoids divide-by-zero)."""
    try:
        custom = float(custom);
        reference = float(reference)
    except (TypeError, ValueError):
        return {'custom': custom, 'reference': reference, 'rel_diff': None, 'verdict': 'n/a'}
    if not np.isfinite(reference) or reference == 0 or not np.isfinite(custom):
        return {'custom': custom, 'reference': reference, 'rel_diff': None, 'verdict': 'n/a'}
    rel = abs(custom - reference) / abs(reference)
    verdict = 'PASS' if rel <= rel_tol else ('WARN' if rel <= 2 * rel_tol else 'FAIL')
    return {'custom': custom, 'reference': reference, 'rel_diff': rel, 'verdict': verdict}


def compare_to_benchmark(custom_time, custom_freq, kubios):
    """Build a per-metric agreement table between the custom pipeline and the
    Kubios reference, with an overall verdict. `kubios` is the dict returned by
    benchmark_against_kubios (or None)."""
    if kubios is None:
        return {'available': False}
    kt, kf = kubios['time'], kubios['freq']
    rows = {
        'HR': _agreement(custom_time['HR'], kt['HR'],
                         BENCHMARK_TOLERANCES['HR_abs_bpm'] / max(kt['HR'], 1e-9)),
        'SDNN': _agreement(custom_time['SDNN'], kt['SDNN'], BENCHMARK_TOLERANCES['SDNN']),
        'RMSSD': _agreement(custom_time['RMSSD'], kt['RMSSD'], BENCHMARK_TOLERANCES['RMSSD']),
        'pNN50': _agreement(custom_time['pNN50'], kt['pNN50'], BENCHMARK_TOLERANCES['pNN50']),
        'LF/HF': _agreement(custom_freq.get('LF/HF', 0), kf.get('LF/HF', 0),
                            BENCHMARK_TOLERANCES['LF/HF']),
    }
    verdicts = [r['verdict'] for r in rows.values() if r['verdict'] != 'n/a']
    overall = ('FAIL' if 'FAIL' in verdicts else
               'WARN' if 'WARN' in verdicts else
               'PASS' if verdicts else 'n/a')
    return {'available': True, 'overall': overall, 'rows': rows,
            'kubios_n_peaks': kubios['n_peaks'],
            'corrected_peaks': kubios.get('corrected_peaks'),
            'inserted_peaks': kubios.get('inserted_peaks'),
            'removed_peaks': kubios.get('removed_peaks'),
            'categories': kubios.get('categories'),
            'n_edits': int(len(kubios.get('inserted_peaks', [])) +
                           len(kubios.get('removed_peaks', []))),
            }

# ─────────────────────────────────────────────────────────────────────────────
# HRV METRICS (continued)
# ─────────────────────────────────────────────────────────────────────────────
def calculate_hrv_metrics(peak_indices, fs, correction):
    """All HRV metrics for one trial from ONE correction result [D5] — the
    exported corrected RR series and these metrics can no longer come from two
    different reconstructions.

    Series analysed:
      raw        every detected interval (time domain only).
      clean      flagged intervals EXCLUDED, real beat times kept (spectral).
      corrected  the reconstruction with unrecoverable gaps dropped; time stamps
                 are the RECONSTRUCTED R-peak times [D6], so a dropped gap stays
                 a gap in time instead of being spliced shut by a cumulative sum.
    Returns the metrics dict (None if < 5 peaks)."""
    peak_indices = np.asarray(peak_indices)
    if len(peak_indices) < 5:
        return None
    rr_ms = np.diff(peak_indices) / fs * 1000
    rr_times_sec = peak_indices[1:] / fs - peak_indices[1] / fs

    gap_mask = np.asarray(correction['gap_mask'], dtype=bool)
    keep = ~gap_mask
    recon = np.asarray(correction['reconstructed'], dtype=float)
    corrected_rr_ms = np.asarray(correction['corrected_rr'], dtype=float)[keep] / fs * 1000
    corrected_rr_times = recon[1:][keep] / fs - recon[1] / fs
    n_unrecoverable = int(np.sum(gap_mask))

    bad_interval = np.asarray(correction['bad'], dtype=bool)
    if len(bad_interval) != len(rr_ms):
        bad_interval = np.zeros(len(rr_ms), dtype=bool)
    clean_rr_ms = rr_ms[~bad_interval]
    clean_rr_times = rr_times_sec[~bad_interval]
    excl_count = int(np.sum(bad_interval))
    excl_rate = excl_count / len(bad_interval) * 100 if len(bad_interval) else 0
    freq_lomb_clean = (
        calculate_lomb_scargle_psd(clean_rr_times, clean_rr_ms)
        if len(clean_rr_ms) >= 10
        else {'LF': 0, 'HF': 0, 'LF/HF': 0, 'quality': 'too_many_exclusions', 'method': 'lomb-scargle'}
    )
    if len(clean_rr_ms) >= 10:
        freq_lomb_clean.update(excluded_beats=excl_count, exclusion_rate=excl_rate)
    freq_lomb_corrected = calculate_lomb_scargle_psd(corrected_rr_times, corrected_rr_ms)
    freq_welch_clean = (
        calculate_welch_psd(clean_rr_ms, rr_times_sec=clean_rr_times)
        if len(clean_rr_ms) >= 30
        else {'LF': 0, 'HF': 0, 'LF/HF': 0, 'quality': 'too_many_exclusions', 'method': 'welch'}
    )
    if len(clean_rr_ms) >= 30:
        freq_welch_clean.update(excluded_beats=excl_count, exclusion_rate=excl_rate)
    freq_welch_corrected = calculate_welch_psd(corrected_rr_ms, rr_times_sec=corrected_rr_times)

    # [D22] successive differences only between intervals adjacent in the
    # reconstruction (none across an excluded stretch)
    time_corrected = calculate_time_domain_hrv(corrected_rr_ms, contiguous=np.diff(np.where(keep)[0]) == 1)
    benchmark = (
        compare_to_benchmark(time_corrected, freq_lomb_corrected,
                             benchmark_against_kubios(peak_indices, fs))
        if RUN_BENCHMARK else {'available': False}
    )
    return {
        'time_raw': calculate_time_domain_hrv(rr_ms),
        'time_corrected': time_corrected,
        'freq_lomb_clean': freq_lomb_clean,
        'freq_lomb_corrected': freq_lomb_corrected,
        'freq_welch_clean': freq_welch_clean,
        'freq_welch_corrected': freq_welch_corrected,
        'n_unrecoverable_gaps': n_unrecoverable,
        'benchmark': benchmark,
        # [D7] first-to-last detected R-peak of the trial window
        'duration_sec': float((peak_indices[-1] - peak_indices[0]) / fs),
    }


# ─────────────────────────────────────────────────────────────────────────────
# EXCEL EXPORT
# ─────────────────────────────────────────────────────────────────────────────
# Sheets 1–7 and their columns are unchanged, so existing readers (the R script
# reads Time_Domain and Data_Quality by column name) keep working. Data_Quality
# gains four columns at the END, and two sheets are appended at the end.
QC_COLUMNS = ['Trial', 'Run', 'Start_Time', 'Start_Interval', 'Flagged_Intervals_L',
              'Expected_Intervals_k', 'Beats_To_Insert', 'Action', 'Span_Sec', 'Target_RR_ms',
              'Gap_to_RR_Ratio', 'Count_Fit_Offset_Pct',
              'Timing_Flagged', 'Morphology_Only', 'Values_From', 'Mean_Posterior_SD_ms', 'GPR_Fit',
              # 2.5 [D23]: what happened to the run's beats (see Data_Quality)
              'Beats_Dropped', 'Beats_Corrected', 'Beats_Inserted', 'Bad_Beats_Kept', 'Exclusion_Reason']


def _run_config_rows(run_info):
    """Provenance for the Run_Config sheet: everything needed to reproduce a
    workbook (parameters, library versions, inputs)."""
    import scipy
    import sklearn
    rows = [('Pipeline_Version', PIPELINE_VERSION),
            ('Script', os.path.basename(__file__) if '__file__' in globals() else 'interactive'),
            ('Run_Timestamp', datetime.now().isoformat(timespec='seconds'))]
    rows += [(k, v) for k, v in (run_info or {}).items()]
    for name in ('DETECTION_METHOD', 'KUBIOS_ALPHA', 'KUBIOS_MRRS_THRESH', 'KUBIOS_TH_FLOOR_MS',
                 'KUBIOS_TH_CEIL_FRAC', 'KUBIOS_WINDOW_BEATS', 'KUBIOS_MEDFILT', 'KUBIOS_C1', 'KUBIOS_C2',
                 'PREMATURE_MIN_FRAC', 'PREMATURE_GRID_TOL', 'RR_REL_MIN_FRAC', 'RHYTHM_HALF_WINDOW',
                 'ALTERNATION_HANDLING', 'ALTERNATION_MIN_AMP', 'ALTERNATION_MIN_RUN',
                 'ALTERNATION_PAIR_MIN_BEATS', 'ALTERNATION_CONTEXT_BEATS', 'ALTERNATION_SUSTAINED_FRAC',
                 'EARLY_CHECK_FRAC',
                 'EARLY_CHECK_WARN_PCT', 'EARLY_BEAT_HANDLING',
                 'RECORDING_GAP_HANDLING', 'RECORDING_GAP_MIN_SEC',
                 'MORPHOLOGY_CORRELATION_THRESHOLD', 'MIN_RR_MS', 'MAX_RR_MS', 'MEDIAN_WINDOW',
                 'MAX_MISSED_BEATS', 'MAX_GAP_RECONSTRUCT_SEC', 'MAX_REPLACE_RUN_SEC',
                 'RR_FILL_METHOD', 'RR_SUM_CONSTRAINT', 'RR_SUM_MAX_OFFSET', 'GPR_KERNEL', 'GPR_N_RESTARTS',
                 'GPR_RANDOM_STATE', 'GPR_MIN_TRAIN', 'MIN_SEGMENT_DURATION', 'RUN_BENCHMARK',
                 'ECG_CHANNEL', 'INVERT_ECG', 'CLOCK_OFFSET_SECONDS', 'USE_LONGEST_FILE_ONLY'):
        rows.append((name, globals().get(name)))
    for mod_name, mod in (('numpy', np), ('pandas', pd), ('scipy', scipy), ('scikit-learn', sklearn),
                          ('neurokit2', nk), ('mne', mne)):
        rows.append((f'version_{mod_name}', getattr(mod, '__version__', '?')))
    return pd.DataFrame([{'Parameter': k, 'Value': str(v)} for k, v in rows])


def export_hrv_to_excel(processed_data, output_path, run_info=None):
    time_domain_data, freq_welch_data, freq_lomb_data, quality_data = [], [], [], []
    benchmark_data, qc_rows = [], []

    raw_rr_dict = {}
    corr_rr_dict = {}

    for trial_name, data in processed_data.items():
        metrics = data['hrv_metrics']
        artifact_mask = data['artifact_mask']
        ectopic_mask = data['ectopic_mask']
        total_beats = len(data['peak_times'])
        m = min(len(artifact_mask), len(ectopic_mask))
        a = artifact_mask[:m].astype(bool)
        e = ectopic_mask[:m].astype(bool)
        n_unique_bad = int(np.sum(a | e))
        t_raw = metrics['time_raw']
        t_corr = metrics['time_corrected']

        # Extract RR interval arrays for export
        raw_t = data['raw_rr_times'].values if hasattr(data['raw_rr_times'], 'values') else data['raw_rr_times']
        raw_rr_dict[f"{trial_name}_Time"] = pd.Series(raw_t)
        raw_rr_dict[f"{trial_name}_RR_ms"] = pd.Series(data['raw_rr_ms'])

        corr_t = data['corrected_rr_times'].values if hasattr(data['corrected_rr_times'], 'values') else data[
            'corrected_rr_times']
        corr_rr_dict[f"{trial_name}_Time"] = pd.Series(corr_t)
        corr_rr_dict[f"{trial_name}_RR_ms"] = pd.Series(data['corrected_rr_ms'])
        corr_rr_dict[f"{trial_name}_Type"] = pd.Series(data['corrected_type'])

        time_domain_data.append({
            'Trial': trial_name,
            'HR_Raw': t_raw['HR'], 'SDNN_Raw': t_raw['SDNN'],
            'RMSSD_Raw': t_raw['RMSSD'], 'SDSD_Raw': t_raw['SDSD'],
            'pNN50_Raw': t_raw['pNN50'], 'NN_Count_Raw': t_raw['NN_count'],
            'HR_Corrected': t_corr['HR'], 'SDNN_Corrected': t_corr['SDNN'],
            'RMSSD_Corrected': t_corr['RMSSD'], 'SDSD_Corrected': t_corr['SDSD'],
            'pNN50_Corrected': t_corr['pNN50'], 'NN_Count_Corrected': t_corr['NN_count'],
            'Delta_HR': t_corr['HR'] - t_raw['HR'],
            'Delta_SDNN': t_corr['SDNN'] - t_raw['SDNN'],
            'Delta_RMSSD': t_corr['RMSSD'] - t_raw['RMSSD'],
        })
        wc, lc = metrics['freq_welch_clean'], metrics['freq_welch_corrected']
        freq_welch_data.append({
            'Trial': trial_name,
            'VLF_Clean': wc.get('VLF', 0), 'LF_Clean': wc.get('LF', 0),
            'HF_Clean': wc.get('HF', 0), 'Total_Power_Clean': wc.get('Total_Power', 0),
            'LF_HF_Ratio_Clean': wc.get('LF/HF', 0),
            'LF_nu_Clean': wc.get('LF_nu', 0), 'HF_nu_Clean': wc.get('HF_nu', 0),
            'Quality_Clean': wc.get('quality', 'unknown'),
            'VLF_Corrected': lc.get('VLF', 0), 'LF_Corrected': lc.get('LF', 0),
            'HF_Corrected': lc.get('HF', 0), 'Total_Power_Corrected': lc.get('Total_Power', 0),
            'LF_HF_Ratio_Corrected': lc.get('LF/HF', 0),
            'Quality_Corrected': lc.get('quality', 'unknown'),
        })
        lc2, lclean = metrics['freq_lomb_corrected'], metrics['freq_lomb_clean']
        freq_lomb_data.append({
            'Trial': trial_name,
            'VLF_Clean': lclean.get('VLF', 0), 'LF_Clean': lclean.get('LF', 0),
            'HF_Clean': lclean.get('HF', 0), 'Total_Power_Clean': lclean.get('Total_Power', 0),
            'LF_HF_Ratio_Clean': lclean.get('LF/HF', 0),
            'Quality_Clean': lclean.get('quality', 'unknown'),
            'VLF_Corrected': lc2.get('VLF', 0), 'LF_Corrected': lc2.get('LF', 0),
            'HF_Corrected': lc2.get('HF', 0), 'Total_Power_Corrected': lc2.get('Total_Power', 0),
            'LF_HF_Ratio_Corrected': lc2.get('LF/HF', 0),
            'Quality_Corrected': lc2.get('quality', 'unknown'),
        })
        ctype = np.asarray(data['corrected_type'])
        n_rep, n_ins, n_mer = (int(np.sum(ctype == t)) for t in ('replaced', 'inserted', 'merged'))
        bd = data.get('breakdown') or {}
        quality_data.append({
            'Trial': trial_name,
            'Total_Beats': total_beats,
            'Artifact_Flags': int(np.sum(a)),
            'Ectopic_Flags': int(np.sum(e)),
            'Unique_Bad_Beats': n_unique_bad,
            'Unique_Bad_Percent': (n_unique_bad / total_beats * 100) if total_beats else 0,
            'Duration_Sec': metrics.get('duration_sec', 0),  # [D7] was always 0 before
            'Welch_Excluded_Beats': wc.get('excluded_beats', 0),
            'Welch_Exclusion_Rate': wc.get('exclusion_rate', 0),
            'Lomb_Excluded_Beats': lclean.get('excluded_beats', 0),
            'Lomb_Exclusion_Rate': lclean.get('exclusion_rate', 0),
            'Unrecoverable_Gaps': metrics.get('n_unrecoverable_gaps', 0),
            # appended in v2 — counts of corrected intervals by how they were made
            'Intervals_Replaced': n_rep,
            'Intervals_Inserted': n_ins,
            'Intervals_Merged': n_mer,
            'Reconstructed_Percent': ((n_rep + n_ins + n_mer) / len(ctype) * 100) if len(ctype) else 0,
            # appended in 2.5 [D23] — the Unique_Bad_Beats split by what happened to them:
            # Unique_Bad_Beats = Beats_Dropped + Beats_Corrected + Bad_Beats_Kept
            'Beats_Dropped': bd.get('dropped'),             # taken out of the beat series:
            'Dropped_Extra_Beats': bd.get('dropped_extra'),  # … extra beats removed
            'Dropped_Excluded': bd.get('dropped_excluded'),  # … inside stretches left out of the analysis
            'Excluded_Alternating': bd.get('excluded_alternating'),  # … of which alternating rhythm [D21]
            'Beats_Corrected': bd.get('corrected'),          # moved to the reconstructed position
            'Corrected_Alternating': bd.get('corrected_alternating'),  # … of which early beats of a short alternation [D28]
            'Bad_Beats_Kept': bd.get('kept'),                # flagged but left in place (run boundaries)
            'Beats_Inserted': bd.get('inserted'),            # missed beats added (not detected beats)
            'Alternating_Rhythm_Percent': bd.get('alternating_pct'),  # [D21] % of intervals, any handling
            'Unflagged_Early_Beats_Percent': bd.get('unflagged_early_pct'),  # [D24] QC: possible late premature beats
            'Unrecorded_Seconds': round(float(data.get('unrecorded_s', 0.0)), 1),  # [D26] window with no ECG
            'Recording_Gaps': data.get('recording_gaps', 0),  # [D26] holes between EDF files inside the window
            'ECG_Channel': data.get('ecg_channel', ECG_CHANNEL),  # [D27] lead this trial was read from
        })
        bench = metrics.get('benchmark') or {}
        if bench.get('available'):
            rows = bench['rows']
            benchmark_data.append({
                'Trial': trial_name,
                'Overall_Verdict': bench['overall'],
                'Kubios_N_Peaks': bench.get('kubios_n_peaks', 0),
                **{f'{k}_Custom': rows[k]['custom'] for k in rows},
                **{f'{k}_Kubios': rows[k]['reference'] for k in rows},
                **{f'{k}_RelDiff': (None if rows[k]['rel_diff'] is None
                                    else round(rows[k]['rel_diff'] * 100, 2)) for k in rows},
                **{f'{k}_Verdict': rows[k]['verdict'] for k in rows},
            })
        else:
            benchmark_data.append({'Trial': trial_name, 'Overall_Verdict': 'unavailable'})

        fs_t = data.get('sfreq')
        peak_times = data['peak_times']
        for r_no, r in enumerate(data.get('runs', []), start=1):
            qc_rows.append({
                'Trial': trial_name, 'Run': r_no,
                'Start_Time': peak_times[r['run_s']] if r['run_s'] < len(peak_times) else None,
                'Start_Interval': r['run_s'], 'Flagged_Intervals_L': r['L'],
                'Expected_Intervals_k': r['k'], 'Beats_To_Insert': r['beats_to_insert'],
                'Action': r['action'], 'Span_Sec': round(r['span_sec'], 3),
                'Target_RR_ms': r['target'] / fs_t * 1000 if fs_t else None,
                # gap / RR_local: far from a whole number (e.g. 2.5) ⇒ the beat
                # count k is ambiguous — worth a look before trusting the run
                'Gap_to_RR_Ratio': round(float(r.get('gap_to_rr_ratio', np.nan)), 3),
                # |gap/k − local rhythm| / rhythm for runs of k ≥ 2 synthesised
                # intervals; > RR_SUM_MAX_OFFSET ⇒ beat count ambiguous [D2]
                'Count_Fit_Offset_Pct': round(100 * float(r.get('count_fit_offset', np.nan)), 1),
                'Timing_Flagged': r.get('timing_flagged'), 'Morphology_Only': r.get('morphology_only'),
                'Values_From': r.get('values_from'),
                'Mean_Posterior_SD_ms': (r['posterior_sd_mean'] / fs_t * 1000
                                         if fs_t and np.isfinite(r.get('posterior_sd_mean', np.nan))
                                         else None),
                'GPR_Fit': data.get('gpr_fit'),
                'Beats_Dropped': r.get('beats_dropped'), 'Beats_Corrected': r.get('beats_corrected'),
                'Beats_Inserted': r.get('beats_inserted'), 'Bad_Beats_Kept': r.get('bad_beats_kept'),
                'Exclusion_Reason': r.get('exclusion_reason') or None,
            })

    df_time = pd.DataFrame(time_domain_data)
    df_welch = pd.DataFrame(freq_welch_data)
    df_lomb = pd.DataFrame(freq_lomb_data)
    df_quality = pd.DataFrame(quality_data)
    df_bench = pd.DataFrame(benchmark_data)
    df_raw_rr = pd.DataFrame(raw_rr_dict)
    df_corr_rr = pd.DataFrame(corr_rr_dict)
    df_qc = pd.DataFrame(qc_rows, columns=QC_COLUMNS)
    df_cfg = _run_config_rows(run_info)

    with pd.ExcelWriter(output_path, engine='openpyxl') as writer:
        df_time.to_excel(writer, sheet_name='Time_Domain', index=False)
        df_welch.to_excel(writer, sheet_name='Freq_Welch', index=False)
        df_lomb.to_excel(writer, sheet_name='Freq_Lomb_Scargle', index=False)
        df_quality.to_excel(writer, sheet_name='Data_Quality', index=False)
        df_bench.to_excel(writer, sheet_name='Benchmark_Kubios', index=False)
        df_raw_rr.to_excel(writer, sheet_name='Raw_RR_Intervals', index=False)
        df_corr_rr.to_excel(writer, sheet_name='Corrected_RR_Intervals', index=False)
        df_qc.to_excel(writer, sheet_name='Reconstruction_QC', index=False)
        df_cfg.to_excel(writer, sheet_name='Run_Config', index=False)

    print(f"\n✅ Excel exported to: {output_path}")
    return df_time, df_welch, df_lomb, df_quality


# ─────────────────────────────────────────────────────────────────────────────
# DATA LOADING + PROCESSING
# Everything below runs only when called from main(); importing this file has
# no side effects (no drive access, no processing, no Dash server).
# ─────────────────────────────────────────────────────────────────────────────
def all_runs():
    """Every participant/state combination with a configured recording."""
    return [(p, s) for p in PARTICIPANTS for s in ('OFF', 'ON') if PARTICIPANTS[p].get(s.lower())]


def output_path_for(participant, state):
    """Workbook path. File names are unchanged from the September run."""
    return os.path.join(OUTPUT_DIR, f"HRV_Analysis_{participant}_{state.upper()}.xlsx")


def _resolve_ecg_channel(ch_names):
    """ECG_CHANNEL if present, else the first channel whose name contains 'ECG'
    (some recordings name it differently in individual EDF segments)."""
    if ECG_CHANNEL in ch_names:
        return ECG_CHANNEL
    return next((ch for ch in ch_names if 'ECG' in ch.upper()), None)


def load_recording(participant, state):
    """Read every EDF matching the participant/state glob, keep the ECG channel,
    stitch the files on their wall-clock time stamps and parse the sync log.
    Returns a dict (df_raw, sfreq, segments, files, paths) or None."""
    paths = resolve_participant_paths(participant, state)
    found_files = find_edf_files(paths)  # [D25] one pattern or several
    if not found_files:
        print(f"❌ No files found matching '{paths['pattern']}' in {paths['edf_dir']}")
        return None
    # [D27] other ECG leads that some trials of this participant are read from
    extra_leads = sorted({c for c in paths['ecg_channel'].values() if c and c != ECG_CHANNEL})

    if USE_LONGEST_FILE_ONLY and len(found_files) > 1:
        durations = []
        for f in found_files:
            hdr = mne.io.read_raw_edf(f, preload=False, verbose=False)
            durations.append(hdr.n_times / hdr.info['sfreq'])
        keep = int(np.argmax(durations))
        print(f"ℹ️  USE_LONGEST_FILE_ONLY: {os.path.basename(found_files[keep])} ({durations[keep]:.0f}s)")
        found_files = [found_files[keep]]

    per_file_dfs, used_files, sfreq = [], [], None
    for f in found_files:
        r = mne.io.read_raw_edf(f, preload=True, verbose=False)
        target_ch = _resolve_ecg_channel(r.ch_names)
        if target_ch is None:
            print(f"❌ No ECG channel found in {os.path.basename(f)}. Skipping file.")
            continue
        if target_ch != ECG_CHANNEL:
            print(f"  ⚠ '{ECG_CHANNEL}' missing in {os.path.basename(f)}. Using '{target_ch}'.")
        picks = [target_ch] + [c for c in extra_leads if c in r.ch_names and c != target_ch]
        try:
            r.pick(picks=picks)
        except AttributeError:
            r.pick_channels(picks)
        if target_ch != ECG_CHANNEL:
            mne.rename_channels(r.info, {target_ch: ECG_CHANNEL})

        f_sfreq = r.info['sfreq']
        if sfreq is None:
            sfreq = f_sfreq
        elif abs(f_sfreq - sfreq) > 1e-6:
            print(f"  ⚠ {os.path.basename(f)}: sfreq {f_sfreq} ≠ {sfreq}; using per-file rate")

        f_base = (pd.to_datetime(r.info['meas_date']).replace(tzinfo=None)
                  if r.info['meas_date'] else pd.Timestamp.now().replace(tzinfo=None))
        fdf = r.to_data_frame(index='time')
        fdf.index = f_base + pd.to_timedelta(fdf.index, unit='s')
        per_file_dfs.append(fdf)
        used_files.append(os.path.basename(f))
        print(f"  • loaded {os.path.basename(f)}: {fdf.index[0]} .. {fdf.index[-1]} ({len(fdf) / f_sfreq:.0f}s)")

    if not per_file_dfs:
        return None

    df_raw = pd.concat(per_file_dfs).sort_index()
    df_raw = df_raw[~df_raw.index.duplicated(keep='first')]
    df_raw.index = pd.DatetimeIndex(df_raw.index)
    base_time = df_raw.index[0]
    segments = parse_log_file_new(paths['sync'], base_time)
    if CLOCK_OFFSET_SECONDS:
        off = pd.Timedelta(seconds=CLOCK_OFFSET_SECONDS)
        for s in segments:
            s['start'] += off
            s['stop'] += off
    print(f"ℹ️  EDF spans {df_raw.index[0]} .. {df_raw.index[-1]}")
    if not segments:
        print("⚠️ No valid segments found in log file.")
    return {'df_raw': df_raw, 'sfreq': sfreq, 'segments': segments,
            'files': used_files, 'paths': paths}


def _positions_to_times(sample_index, positions):
    """Clock times of (possibly fractional) sample positions within a segment,
    interpolated from the segment's own sample timestamps. Integer positions
    return exactly the timestamp of that sample, so a kept beat has the same
    time stamp in the raw and the corrected series, and times stay correct
    even where two EDF files join inside the window."""
    positions = np.asarray(positions, dtype=float) if positions is not None else np.array([])
    if not len(positions):
        return pd.DatetimeIndex([])
    ns = pd.DatetimeIndex(sample_index).asi8
    rel = np.interp(positions, np.arange(len(ns)), (ns - ns[0]).astype(float))
    return pd.DatetimeIndex(ns[0] + np.round(rel).astype(np.int64))


def _plot_payload(ecg_clean, segment_padded, pad_t1, t_start, t_stop, sfreq, benchmark):
    """Dashboard-only arrays (ECG slice, Kubios overlay). Skipped in batch mode,
    where nothing is plotted."""

    def _idx_to_times(arr):
        return _positions_to_times(segment_padded.index, arr)

    def _idx_to_ecg_y(arr):
        arr = np.asarray(arr, dtype=float) if arr is not None else np.array([])
        if not len(arr):
            return np.array([])
        ci = np.clip(arr.astype(int), 0, len(ecg_clean) - 1)
        return ecg_clean[ci]

    kub_peaks = benchmark.get('corrected_peaks')
    if kub_peaks is not None and len(kub_peaks) > 2:
        kub_peak_times = _idx_to_times(kub_peaks)
        kub_peak_y = _idx_to_ecg_y(kub_peaks)
        kub_rr = np.diff(np.asarray(kub_peaks, dtype=float)) / sfreq * 1000
        kub_rr_times = kub_peak_times[1:]
    else:
        kub_peak_times = pd.DatetimeIndex([])
        kub_peak_y = np.array([])
        kub_rr = np.array([])
        kub_rr_times = pd.DatetimeIndex([])

    ecg_slice = ecg_clean[len(segment_padded.loc[pad_t1:t_start]):len(segment_padded.loc[pad_t1:t_stop])]
    time_slice = segment_padded.loc[t_start:t_stop].index
    return {
        'ecg_time': time_slice, 'ecg_signal': ecg_slice,
        'kubios_peak_times': kub_peak_times, 'kubios_peak_y': kub_peak_y, 'kubios_rr': kub_rr,
        'kubios_rr_times': kub_rr_times,
        'kubios_inserted_times': _idx_to_times(benchmark.get('inserted_peaks')),
        'kubios_inserted_y': _idx_to_ecg_y(benchmark.get('inserted_peaks')),
        'kubios_removed_times': _idx_to_times(benchmark.get('removed_peaks')),
        'kubios_removed_y': _idx_to_ecg_y(benchmark.get('removed_peaks')),
    }


def process_trial(seg, df_raw, sfreq, with_plots=False):
    """One trial window: R-peaks → morphology check → ONE correction pass →
    metrics. Returns the per-trial dict used by the export and the dashboard,
    or None when the window cannot be analysed."""
    trial_name = seg['name']
    t_start, t_stop = seg['start'], seg['stop']
    if t_start > df_raw.index[-1] or t_stop < df_raw.index[0]:
        print(f"  ⚠ {trial_name}: window outside recording")
        return None
    pad_t1 = t_start - pd.Timedelta(seconds=PAD_SECONDS)
    pad_t2 = t_stop + pd.Timedelta(seconds=PAD_SECONDS)
    segment_padded = df_raw[(df_raw.index >= pad_t1) & (df_raw.index <= pad_t2)]
    if len(segment_padded) < sfreq * 5:
        print(f"  ⚠ {trial_name}: too few samples in window")
        return None

    channel = seg.get('ecg_channel') or ECG_CHANNEL  # [D27]
    if channel != ECG_CHANNEL and (channel not in segment_padded.columns
                                   or segment_padded[channel].isna().any()):
        print(f"  ⚠ {trial_name}: '{channel}' not recorded throughout this window; using {ECG_CHANNEL}")
        channel = ECG_CHANNEL
    if channel != ECG_CHANNEL or segment_padded.shape[1] > 1:
        segment_padded = segment_padded[[channel]].rename(columns={channel: ECG_CHANNEL})
    sig_vals = (-segment_padded[ECG_CHANNEL].values if INVERT_ECG else segment_padded[ECG_CHANNEL].values)
    ecg_clean = nk.ecg_clean(sig_vals, sampling_rate=sfreq, method="elgendi2010")
    _, info = nk.ecg_peaks(ecg_clean, sampling_rate=sfreq, method="neurokit")
    raw_peaks = info["ECG_R_Peaks"]
    snapped = snap_to_local_max(ecg_clean, raw_peaks, sfreq, SNAP_WINDOW)
    filtered = remove_small_peaks(ecg_clean, snapped, ratio=NOISE_THRESHOLD)
    final_idx = clean_artifact_peaks(filtered, ecg_clean, sfreq)
    peak_times_padded = segment_padded.index[final_idx.astype(int)]
    mask_valid = (peak_times_padded >= t_start) & (peak_times_padded <= t_stop)
    valid_peaks_idx = final_idx[mask_valid].astype(int)
    valid_peaks_times = peak_times_padded[mask_valid]
    if len(valid_peaks_idx) < 10:
        print(f"  ⚠ Skipping {trial_name}: insufficient peaks ({len(valid_peaks_idx)})")
        return None

    # [D15] Timing artefacts are detected on the PADDED beat series (the
    # PAD_SECONDS of ECG already loaded on each side) and then cut back to the
    # window, so the window's first and last beats are judged with neighbours on
    # both sides. Detecting on the window alone leaves edge intervals unchecked.
    w0, nv = int(np.argmax(mask_valid)), len(valid_peaks_idx)
    all_idx = final_idx.astype(int)
    ctx_timing, _ = detect_outlier_intervals(all_idx, sfreq)
    timing_window = ctx_timing[w0:w0 + nv - 1] if len(ctx_timing) >= w0 + nv - 1 else None
    ctx_rr_all = np.diff(all_idx) / sfreq * 1000.0
    ctx_alt = _alternation_mask(ctx_rr_all)  # [D21], same padded series
    ctx_sus = _alternation_sustained(ctx_rr_all, ctx_alt)  # [D28] which stretches are sustained
    alt_window = ctx_alt[w0:w0 + nv - 1] if len(ctx_alt) >= w0 + nv - 1 else None
    sus_window = ctx_sus[w0:w0 + nv - 1] if alt_window is not None else None
    ctx_hole = recording_gap_intervals(segment_padded.index, all_idx)  # [D26] holes in the recording
    hole_window = ctx_hole[w0:w0 + nv - 1] if len(ctx_hole) >= w0 + nv - 1 else None

    template_for, _template_beat = build_templates(ecg_clean, valid_peaks_idx, sfreq)
    ectopic_mask = detect_ectopic_beats(valid_peaks_idx, ecg_clean, sfreq, template_for)
    correction = perform_artifact_correction(valid_peaks_idx, sfreq, combined_bad_mask=ectopic_mask,
                                             timing_bad=timing_window, alternating=alt_window,
                                             alternating_sustained=sus_window,
                                             recording_gap=hole_window)
    hrv_results = calculate_hrv_metrics(valid_peaks_idx, sfreq, correction)  # same correction [D5]
    if hrv_results is None:
        return None

    artifact_mask = correction['peak_outlier_mask']
    reconstructed_times = _positions_to_times(segment_padded.index, correction['reconstructed'])
    trial = {
        'peak_times': valid_peaks_times, 'peak_y': ecg_clean[valid_peaks_idx],
        'peak_times_corrected': reconstructed_times, 'peak_y_corrected': ecg_clean[valid_peaks_idx],
        'raw_rr_ms': np.diff(valid_peaks_idx) / sfreq * 1000.0, 'raw_rr_times': valid_peaks_times[1:],
        'artifact_mask': artifact_mask, 'ectopic_mask': ectopic_mask, 'hrv_metrics': hrv_results,
        'corrected_beat_mask': correction['corrected_beat_mask'],
        'corrected_rr_ms': correction['corrected_rr'] / sfreq * 1000.0,
        'corrected_rr_times': reconstructed_times[1:],
        'corrected_type': correction['corrected_type'],
        'runs': correction['runs'], 'gpr_fit': correction['gpr_fit'], 'sfreq': sfreq,
        'beat_fate': correction['beat_fate'], 'breakdown': correction['breakdown'],
        'ecg_channel': channel,  # [D27]
        'unrecorded_s': unrecorded_seconds(segment_padded.index, t_start, t_stop, sfreq),  # [D26]
        'recording_gaps': int(np.sum(hole_window)) if hole_window is not None else 0,  # [D26]
    }
    if with_plots:
        trial.update(_plot_payload(ecg_clean, segment_padded, pad_t1, t_start, t_stop, sfreq,
                                   hrv_results.get('benchmark') or {}))
        # tachogram flags/band from the same padded detection, cut to the window [D15]
        ctx_rr_ms = np.diff(all_idx) / sfreq * 1000.0
        cut = slice(w0, w0 + nv - 1)
        trial['rr_reasons'] = {k: v[cut] for k, v in classify_rr_outlier_reasons(ctx_rr_ms).items()}
        trial['rr_bounds'] = tuple(np.asarray(b)[cut] for b in compute_rr_bounds(ctx_rr_ms))
    return trial


def _segments_for_state(segments, state):
    """[D20] Keep the sync-log trials of this medication state. A recording can
    span both sessions (P-015's OFF EDF files also cover the ON session, and its
    sync log lists both), so trials named for the OTHER state ('ON_…' while
    processing OFF, and vice versa) would otherwise be processed into this
    state's workbook as well. Names without an ON/OFF prefix are kept.
    Returns (kept_segments, skipped_names)."""
    import re
    other = 'ON' if str(state).strip().upper() == 'OFF' else 'OFF'
    kept, skipped = [], []
    for s in segments:
        m = re.match(r'^\s*(ON|OFF)(?![A-Za-z])', str(s['name']), re.IGNORECASE)
        if m and m.group(1).upper() == other:
            skipped.append(s['name'])
        else:
            kept.append(s)
    return kept, skipped


def process_participant_state(participant, state, with_plots=False):
    """All trials of one participant/state. Returns ({trial: data}, run_info)."""
    print("\n" + "═" * 70)
    print(f"▶ Processing Participant {participant} · {state.upper()} state")
    paths = resolve_participant_paths(participant, state)
    print(f"  EDF : {paths['edf_dir']}")
    print(f"  glob: {paths['pattern']}")
    print(f"  sync: {paths['sync']}")
    print("═" * 70)
    rec = load_recording(participant, state)
    if rec is None:
        return {}, {}
    segments, skipped = _segments_for_state(rec['segments'], state)
    if skipped:
        print(f"  ℹ️  {len(skipped)} trial(s) named for the other medication state are in this recording's "
              f"time range and were skipped [D20]: {', '.join(skipped[:4])}{' …' if len(skipped) > 4 else ''}")
    leads = {k: v for k, v in (rec['paths'].get('ecg_channel') or {}).items()
             if v and any(sg['name'] == k for sg in segments)}
    for seg in segments:  # [D27] per-trial ECG lead from the registry
        if seg['name'] in leads:
            seg['ecg_channel'] = leads[seg['name']]
    processed = {}
    for seg in segments:
        try:
            trial = process_trial(seg, rec['df_raw'], rec['sfreq'], with_plots=with_plots)
        except Exception as _seg_err:
            print(f"  ❌ {seg['name']}: skipped due to error → {_seg_err}")
            continue
        if trial is None:
            continue
        processed[seg['name']] = trial
        _e = trial['ectopic_mask'].astype(bool)
        _b, _n = trial['breakdown'], len(trial['peak_times'])
        print(f"  ✓ {seg['name']}: {_n} beats | {_b['unique_bad']} bad ({100 * _b['unique_bad'] / _n:.1f} %) = "
              f"{_b['dropped']} dropped ({_b['dropped_extra']} extra, {_b['dropped_excluded']} excluded) + "
              f"{_b['corrected']} corrected + {_b['kept']} kept | {_b['inserted']} inserted | "
              f"{int(np.sum(_e))} abnormal shape"
              + (f" | alternating rhythm {_b['alternating_pct']:.0f} % [D21]: {_b.get('corrected_alternating', 0)} beats "
                 f"corrected, {_b['excluded_alternating']} excluded [D28]" if _b['alternating_pct'] >= 1 else '')
              + (f" | ⚠ {_b['unflagged_early_pct']:.0f} % unflagged early beats [D24]"
                 if _b.get('unflagged_early_pct', 0) >= EARLY_CHECK_WARN_PCT else '')
              + (f" | read from {trial['ecg_channel']} [D27]" if trial.get('ecg_channel') != ECG_CHANNEL else '')
              + (f" | ⚠ {trial['unrecorded_s']:.0f} s of the window not recorded [D26]"
                 if trial.get('unrecorded_s', 0) >= 2 else ''))
    print(f"\nℹ️  Processed {len(processed)}/{len(segments)} trials within the loaded recording(s).")
    run_info = {'Participant': participant, 'State': state.upper(), 'Sampling_Rate_Hz': rec['sfreq'],
                'EDF_Files': '; '.join(rec['files']), 'Sync_Log': rec['paths']['sync'],
                'ECG_Channel_By_Trial': ('; '.join(f'{k}: {v}' for k, v in leads.items())
                                         if leads else f'all trials: {ECG_CHANNEL}')}  # [D27]
    return processed, run_info


def preflight(runs):
    """DRY_RUN in batch mode: check every registry entry WITHOUT processing —
    EDF files found, ECG channel present in each header, sync log readable,
    trials parsed, and which workbook would be written."""
    print(f"\n🔎 DRY RUN — preflight of {len(runs)} participant/state recordings. Nothing is processed or written.")
    print(f"   Output folder would be: {OUTPUT_DIR} "
          f"({'exists' if os.path.isdir(OUTPUT_DIR) else 'will be created'})\n")
    n_blocked = 0
    for p, s in runs:
        paths = resolve_participant_paths(p, s)
        edfs = find_edf_files(paths)  # [D25]
        blocking, warn = [], []
        if not edfs:
            blocking.append('no EDF files match the glob')
        n_ecg_ok, spans, leads_in = 0, [], []
        for f in edfs:
            try:
                hdr = mne.io.read_raw_edf(f, preload=False, verbose=False)
                if _resolve_ecg_channel(hdr.ch_names) is None:
                    warn.append(f'no ECG channel in {os.path.basename(f)} (file will be skipped)')
                else:
                    n_ecg_ok += 1
                    leads_in.append(set(hdr.ch_names))
                    if hdr.info['meas_date'] is not None:
                        t0 = pd.to_datetime(hdr.info['meas_date']).replace(tzinfo=None)
                        spans.append((t0, t0 + pd.Timedelta(seconds=hdr.n_times / hdr.info['sfreq'])))
            except Exception as e:
                warn.append(f'unreadable {os.path.basename(f)}: {e}')
        if edfs and n_ecg_ok == 0:
            blocking.append('no readable EDF with an ECG channel')
        n_trials = 0
        if os.path.isfile(paths['sync']):
            base = min(a for a, _ in spans) if spans else pd.Timestamp('2000-01-01')
            _all = parse_log_file_new(paths['sync'], base)
            segs = _segments_for_state(_all, s)[0]
            n_trials = len(segs)
            if not _all:
                blocking.append('sync log has no start/stop trial pairs')
            elif n_trials == 0:
                blocking.append(f'no {s} trials in the sync log (all are named for the other state) [D20]')
            # per-trial checks against the EDF headers: is each window recorded? [D25, D26]
            short, outside, partial = [], [], []
            for sg in segs:
                a, b = sg['start'], sg['stop']
                dur = (b - a).total_seconds()
                if dur < 5:
                    short.append(sg['name'])
                    continue
                if not spans:
                    continue
                pts = sorted((max(x, a), min(y, b)) for x, y in spans if y > a and x < b)
                merged = []
                for x, y in pts:
                    if merged and x <= merged[-1][1]:
                        merged[-1][1] = max(merged[-1][1], y)
                    else:
                        merged.append([x, y])
                cov = sum((y - x).total_seconds() for x, y in merged)
                if cov < 1:
                    outside.append(sg['name'])
                elif cov < dur - 2:
                    partial.append(f"{sg['name']} ({dur - cov:.0f} s)")

            def _few(names):
                return ', '.join(names[:4]) + (' …' if len(names) > 4 else '')
            if short:
                warn.append(f'{len(short)} trial(s) under 5 s in the sync log (placeholders, skipped): {_few(short)}')
            if outside:
                warn.append(f'{len(outside)} trial(s) outside these EDF files (skipped): {_few(outside)}')
            if partial:
                warn.append(f'{len(partial)} trial(s) partly unrecorded [D26]: {_few(partial)}')
            for tr, ch in paths['ecg_channel'].items():  # [D27]
                if any(sg['name'] == tr for sg in segs) and leads_in and not all(ch in c for c in leads_in):
                    warn.append(f"'{ch}' (set for {tr}) is missing from some EDF files [D27]")
        else:
            blocking.append('sync log not found')
        out = output_path_for(p, s)
        if os.path.exists(out):
            warn.append('workbook exists and would be overwritten')
        n_blocked += int(bool(blocking))
        status = '✗' if blocking else ('⚠' if warn else '✓')
        notes = blocking + warn
        print(f"  {status} {p} {s:<3}  {len(edfs)} EDF  {n_trials:>2} trials  → {os.path.basename(out)}"
              + (f"   [{'; '.join(notes)}]" if notes else ''))
    print(f"\n{len(runs) - n_blocked}/{len(runs)} recordings ready to process "
          f"(✗ = would be skipped). Set DRY_RUN = False to process and write.")


def run_batch():
    runs = all_runs()
    print(f"🚀 BATCH MODE: {len(runs)} participant/state combinations.")
    if DRY_RUN:
        preflight(runs)
        return
    os.makedirs(OUTPUT_DIR, exist_ok=True)
    summary = []
    t0 = time.time()
    for current_p, current_s in runs:
        try:
            processed, run_info = process_participant_state(current_p, current_s, with_plots=False)
            if processed:
                export_hrv_to_excel(processed, output_path_for(current_p, current_s), run_info)
            summary.append((current_p, current_s, len(processed), 'ok' if processed else 'no trials'))
        except Exception as e:
            print(f"❌ Error processing {current_p} {current_s}: {e}")
            traceback.print_exc()
            summary.append((current_p, current_s, 0, f'error: {e}'))
    print("\n" + "=" * 70)
    print(f"✅ BATCH PROCESSING COMPLETE in {(time.time() - t0) / 60:.1f} min → {OUTPUT_DIR}")
    for p, s, n, status in summary:
        print(f"   {p} {s:<3} {n:>3} trials  {status}")
    print("=" * 70)


def run_single():
    """Process PARTICIPANT/STATE, export (unless DRY_RUN) and open the dashboard."""
    global PROCESSED_DATA
    PROCESSED_DATA, run_info = process_participant_state(PARTICIPANT, STATE, with_plots=True)
    if not PROCESSED_DATA:
        print("\n⚠️  No data processed. Check file paths and log file.")
        return
    out = output_path_for(PARTICIPANT, STATE)
    if DRY_RUN:
        print(f"\nℹ️  DRY_RUN: workbook not written (would write {out}).")
    else:
        os.makedirs(OUTPUT_DIR, exist_ok=True)
        export_hrv_to_excel(PROCESSED_DATA, out, run_info)
    print("\n" + "=" * 70)
    print("🚀 STARTING INTERACTIVE DASHBOARD")
    print("=" * 70)
    print(f"\n✅ Successfully processed {len(PROCESSED_DATA)} trials!")
    print("\nOpen your browser: http://127.0.0.1:8050/\n")
    app = create_dash_app()
    app.run(debug=True, use_reloader=False)


def main():
    print(f"HRV pipeline {PIPELINE_VERSION} | reconstruction: {RR_FILL_METHOD}"
          f"{' (' + GPR_KERNEL + ' kernel)' if RR_FILL_METHOD == 'gpr' else ''}, sum constraint: {RR_SUM_CONSTRAINT} | "
          f"{'BATCH' if BATCH_MODE else f'SINGLE {PARTICIPANT} {STATE.upper()}'} | DRY_RUN={DRY_RUN}")
    if BATCH_MODE:
        run_batch()
    else:
        run_single()


# ─────────────────────────────────────────────────────────────────────────────
# DASH APP
# ─────────────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────
# STATS PANEL — pure html.* components, NO dcc.Markdown
#
# ROOT CAUSE OF removeChild: dcc.Markdown renders an opaque markdown-to-HTML
# tree (table → thead → tbody → tr → td …). React 18's stricter concurrent-
# mode reconciler diffs this deep tree on every callback update. Because the
# rendered HTML is produced externally (the marked.js parser inside the
# component), React cannot attach stable fiber keys to individual rows/cells.
# When the content changes, React tries to delete the old nodes from the DOM,
# but the markdown renderer has already swapped them, leaving React holding a
# reference to a node that is no longer a child of its recorded parent →
# "removeChild: node is not a child of this node".
#
# Replacing with native html.Table gives React stable fiber references it
# generated itself, so reconciliation is clean.
# ─────────────────────────────────────────────────────────────────────────────
_TH_S = {
    'padding': '4px 10px', 'textAlign': 'left',
    'borderBottom': '2px solid #dee2e6', 'backgroundColor': '#f0f0f0',
    'fontSize': '12px', 'fontWeight': 'bold',
}
_TD_S = {'padding': '3px 10px', 'borderBottom': '1px solid #eee', 'fontSize': '12px'}
_TABLE_S = {'borderCollapse': 'collapse', 'width': '100%', 'marginTop': '6px', 'marginBottom': '10px'}


def _time_row(label, raw_val, corr_val, unit):
    delta = corr_val - raw_val
    delta_color = '#27ae60' if delta >= 0 else '#c0392b'
    return html.Tr([
        html.Td(html.B(label), style=_TD_S),
        html.Td(f"{raw_val:.1f}", style={**_TD_S, 'textAlign': 'right'}),
        html.Td(html.B(f"{corr_val:.1f}"), style={**_TD_S, 'textAlign': 'right'}),
        html.Td(f"{delta:+.1f}", style={**_TD_S, 'textAlign': 'right', 'color': delta_color}),
        html.Td(unit, style={**_TD_S, 'color': '#888'}),
    ])


def _freq_row(label, power, peak):
    peak_str = f"{peak:.3f}" if isinstance(peak, float) else "—"
    return html.Tr([
        html.Td(html.B(label), style=_TD_S),
        html.Td(f"{power:.2f}", style={**_TD_S, 'textAlign': 'right'}),
        html.Td(peak_str, style={**_TD_S, 'textAlign': 'right'}),
    ])


def build_stats_panel(t_raw, t_corr, f_clean, method_name, total_beats,
                      n_unique_bad, n_artifact_only, n_ectopic_only, n_both,
                      benchmark=None, n_unrecoverable=0, breakdown=None,
                      unrecorded_s=0.0, ecg_channel=None):
    pct = n_unique_bad / total_beats * 100 if total_beats else 0
    excl = f_clean.get('excluded_beats', 0)
    excl_rate = f_clean.get('exclusion_rate', 0)
    dur = f_clean.get('duration_sec', 0)
    lf_hf = f_clean.get('LF/HF', 0)
    lf_nu = f_clean.get('LF_nu', 0)
    hf_nu = f_clean.get('HF_nu', 0)

    badge_style = {
        'display': 'inline-block', 'padding': '1px 8px',
        'borderRadius': '3px', 'marginRight': '6px',
        'fontSize': '12px', 'fontWeight': 'bold',
    }

    return [
        # ── Header ──────────────────────────────────────────────────────────
        html.Div(
            f"HRV Analysis Report — {method_name} Method",
            style={'fontSize': '14px', 'fontWeight': 'bold',
                   'color': '#2c3e50', 'marginBottom': '8px'}
        ),
        # ── Quality badges ───────────────────────────────────────────────────
        html.Div([
            html.Span(f"Beats: {total_beats}",
                      style={**badge_style, 'backgroundColor': '#d5f5e3', 'color': '#1e8449'}),
            html.Span(f"Bad: {n_unique_bad} ({pct:.1f}%)",
                      style={**badge_style, 'backgroundColor': '#fadbd8', 'color': '#922b21'}),
            html.Span(f"Duration: {dur:.0f}s",
                      style={**badge_style, 'backgroundColor': '#d6eaf8', 'color': '#1a5276'}),
            html.Span(f"Excluded: {excl} ({excl_rate:.1f}%)",
                      style={**badge_style, 'backgroundColor': '#fef9e7', 'color': '#7d6608'}),
        ], style={'marginBottom': '4px'}),
        html.Div(
            f"Interval-flagged: {n_artifact_only}  ·  Ectopic-only: {n_ectopic_only}  ·  Both: {n_both}",
            style={'fontSize': '11px', 'color': '#666', 'marginBottom': '2px'}
        ),
        # [D23] what happened to the bad beats (sums to the Bad badge)
        *([html.Div(
            f"Bad beats: {breakdown['dropped']} dropped ({breakdown['dropped_extra']} extra, "
            f"{breakdown['dropped_excluded']} in excluded stretches)  ·  {breakdown['corrected']} corrected "
            f"(re-timed)  ·  {breakdown['kept']} kept in place  ·  {breakdown['inserted']} inserted",
            style={'fontSize': '11px', 'color': '#666', 'marginBottom': '2px'})] if breakdown else []),
        *([html.Div(
            f"⚠ Alternating rhythm in {breakdown['alternating_pct']:.0f} % of intervals [D21]"
            + (f" — {breakdown.get('corrected_alternating', 0)} early beats corrected (short stretches), "
               f"{breakdown['excluded_alternating']} beats excluded (sustained) [D28]"
               if ALTERNATION_HANDLING == 'auto' else
               " — excluded" if ALTERNATION_HANDLING == 'exclude' else
               " — kept as NN (ALTERNATION_HANDLING = 'keep')" if ALTERNATION_HANDLING == 'keep' else ''),
            style={'fontSize': '11px', 'color': '#922b21', 'fontWeight': 'bold', 'marginBottom': '2px'})]
          if breakdown and breakdown.get('alternating_pct', 0) >= 1 else []),
        *([html.Div(
            f"⚠ {breakdown['unflagged_early_pct']:.0f} % of intervals end in a slightly early beat (≥ 10 % early, "
            f"normal neighbours) that is not flagged — possible frequent late premature beats [D24]",
            style={'fontSize': '11px', 'color': '#922b21', 'fontWeight': 'bold', 'marginBottom': '2px'})]
          if breakdown and breakdown.get('unflagged_early_pct', 0) >= EARLY_CHECK_WARN_PCT else []),
        *([html.Div(
            f"⚠ {unrecorded_s:.0f} s of this window were not recorded (gap between EDF files or past the "
            f"recording's start/end)"
            + ("; the interval across a gap is excluded [D26]" if RECORDING_GAP_HANDLING == 'exclude'
               else " — not acted on (RECORDING_GAP_HANDLING = 'off') [D26]"),
            style={'fontSize': '11px', 'color': '#922b21', 'fontWeight': 'bold', 'marginBottom': '2px'})]
          if unrecorded_s and unrecorded_s >= 2 else []),
        *([html.Div(f"Read from {ecg_channel} (registry setting for this trial) [D27]",
                    style={'fontSize': '11px', 'color': '#1a5276', 'marginBottom': '2px'})]
          if ecg_channel and ecg_channel != ECG_CHANNEL else []),
        html.Div(style={'marginBottom': '8px'}),
        html.Hr(style={'margin': '6px 0', 'borderColor': '#dee2e6'}),

        # ── Time-domain table ────────────────────────────────────────────────
        html.Div("Time-Domain Metrics",
                 style={'fontWeight': 'bold', 'fontSize': '12px', 'color': '#2c3e50'}),
        html.Table([
            html.Thead(html.Tr([
                html.Th("Metric", style=_TH_S),
                html.Th("Raw", style={**_TH_S, 'textAlign': 'right'}),
                html.Th("Corrected", style={**_TH_S, 'textAlign': 'right'}),
                html.Th("Δ", style={**_TH_S, 'textAlign': 'right'}),
                html.Th("Unit", style=_TH_S),
            ])),
            html.Tbody([
                _time_row("HR", t_raw['HR'], t_corr['HR'], "bpm"),
                _time_row("SDNN", t_raw['SDNN'], t_corr['SDNN'], "ms"),
                _time_row("RMSSD", t_raw['RMSSD'], t_corr['RMSSD'], "ms"),
                _time_row("SDSD", t_raw['SDSD'], t_corr['SDSD'], "ms"),
                _time_row("pNN50", t_raw['pNN50'], t_corr['pNN50'], "%"),
            ]),
        ], style=_TABLE_S),
        html.Hr(style={'margin': '6px 0', 'borderColor': '#dee2e6'}),

        # ── Frequency-domain table ───────────────────────────────────────────
        html.Div(f"Frequency-Domain — {method_name} (Clean)",
                 style={'fontWeight': 'bold', 'fontSize': '12px', 'color': '#2c3e50'}),
        html.Table([
            html.Thead(html.Tr([
                html.Th("Band", style=_TH_S),
                html.Th("Power (ms²)", style={**_TH_S, 'textAlign': 'right'}),
                html.Th("Peak (Hz)", style={**_TH_S, 'textAlign': 'right'}),
            ])),
            html.Tbody([
                _freq_row("VLF", f_clean.get('VLF', 0), f_clean.get('VLF_peak', 0)),
                _freq_row("LF", f_clean.get('LF', 0), f_clean.get('LF_peak', 0)),
                _freq_row("HF", f_clean.get('HF', 0), f_clean.get('HF_peak', 0)),
                _freq_row("Total", f_clean.get('Total_Power', 0), "—"),
            ]),
        ], style=_TABLE_S),
        html.Div([
            html.Span(f"LF/HF: {lf_hf:.2f}",
                      style={**badge_style, 'backgroundColor': '#eaf2ff', 'color': '#1a5276'}),
            html.Span(f"LF(nu): {lf_nu:.1f}%",
                      style={**badge_style, 'backgroundColor': '#eaf2ff', 'color': '#1a5276'}),
            html.Span(f"HF(nu): {hf_nu:.1f}%",
                      style={**badge_style, 'backgroundColor': '#eaf2ff', 'color': '#1a5276'}),
        ]),

        # ── Benchmark vs Kubios / Lipponen–Tarvainen ─────────────────────────
        *_benchmark_section(benchmark, n_unrecoverable, badge_style),
    ]


_VERDICT_COLORS = {
    'PASS': ('#d5f5e3', '#1e8449'), 'WARN': ('#fef9e7', '#7d6608'),
    'FAIL': ('#fadbd8', '#922b21'), 'n/a': ('#eee', '#666'),
}


def _benchmark_section(benchmark, n_unrecoverable, badge_style):
    if not benchmark or not benchmark.get('available'):
        note = ("Benchmark unavailable (too few beats or disabled)."
                if RUN_BENCHMARK else "Benchmark disabled (RUN_BENCHMARK=False).")
        return [html.Div(note, style={'fontSize': '11px', 'color': '#888',
                                      'marginTop': '10px', 'fontStyle': 'italic'})]
    overall = benchmark['overall']
    bg, fg = _VERDICT_COLORS.get(overall, _VERDICT_COLORS['n/a'])

    def row(metric, r):
        rd = "—" if r['rel_diff'] is None else f"{r['rel_diff'] * 100:.1f}%"
        vbg, vfg = _VERDICT_COLORS.get(r['verdict'], _VERDICT_COLORS['n/a'])
        return html.Tr([
            html.Td(html.B(metric), style=_TD_S),
            html.Td(f"{r['custom']:.2f}", style={**_TD_S, 'textAlign': 'right'}),
            html.Td(f"{(r['reference'] or 0):.2f}", style={**_TD_S, 'textAlign': 'right'}),
            html.Td(rd, style={**_TD_S, 'textAlign': 'right'}),
            html.Td(r['verdict'], style={**_TD_S, 'textAlign': 'center',
                                         'backgroundColor': vbg, 'color': vfg,
                                         'fontWeight': 'bold'}),
        ])

    return [
        html.Hr(style={'margin': '8px 0', 'borderColor': '#dee2e6'}),
        html.Div([
            html.Span("Validation vs Kubios (Lipponen–Tarvainen 2019)",
                      style={'fontWeight': 'bold', 'fontSize': '12px', 'color': '#2c3e50'}),
            html.Span(f"Overall: {overall}",
                      style={**badge_style, 'marginLeft': '8px',
                             'backgroundColor': bg, 'color': fg}),
        ]),
        html.Table([
            html.Thead(html.Tr([
                html.Th("Metric", style=_TH_S),
                html.Th("Custom", style={**_TH_S, 'textAlign': 'right'}),
                html.Th("Kubios", style={**_TH_S, 'textAlign': 'right'}),
                html.Th("Rel. Δ", style={**_TH_S, 'textAlign': 'right'}),
                html.Th("Verdict", style={**_TH_S, 'textAlign': 'center'}),
            ])),
            html.Tbody([row(k, v) for k, v in benchmark['rows'].items()]),
        ], style=_TABLE_S),
        html.Div(
            f"Tolerances: SDNN/RMSSD ±{BENCHMARK_TOLERANCES['SDNN'] * 100:.0f}%, "
            f"LF/HF ±{BENCHMARK_TOLERANCES['LF/HF'] * 100:.0f}%, "
            f"HR ±{BENCHMARK_TOLERANCES['HR_abs_bpm']:.0f} bpm (WARN = within 2×). "
            f"Unrecoverable gaps excluded: {n_unrecoverable}.",
            style={'fontSize': '11px', 'color': '#666', 'marginTop': '2px'}),
    ]


# ─────────────────────────────────────────────────────────────────────────────
# DASH APP — the layout is built after processing (create_dash_app); the
# callbacks are registered with dash.callback so they bind to that app.
# ─────────────────────────────────────────────────────────────────────────────
GRAPH_STYLE = {'height': '100%', 'width': '100%'}
GRAPH_CONFIG = {'displaylogo': False, 'responsive': True}


def create_dash_app():
    """Dashboard for the trials in PROCESSED_DATA."""
    app = Dash(__name__, suppress_callback_exceptions=True)
    app.layout = html.Div([
        html.H2("Scientific HRV Analysis Dashboard",
                style={'textAlign': 'center', 'fontFamily': 'Arial', 'color': '#2c3e50',
                       'marginBottom': '10px'}),

        # ── Controls bar ────────────────────────────────────────────────────────
        html.Div([
            html.Div([
                html.Label("Select Trial:", style={'fontWeight': 'bold', 'display': 'block'}),
                dcc.Dropdown(
                    id='trial-dropdown',
                    options=[{'label': k, 'value': k} for k in PROCESSED_DATA],
                    value=list(PROCESSED_DATA)[0] if PROCESSED_DATA else None,
                    clearable=False,
                ),
            ], style={'width': '40%', 'display': 'inline-block', 'verticalAlign': 'top'}),

            html.Div([
                html.Label("PSD Method:", style={'fontWeight': 'bold', 'display': 'block'}),
                dcc.RadioItems(
                    id='psd-method-toggle',
                    options=[{'label': '🔬 Lomb-Scargle (primary)', 'value': 'lomb'},
                             {'label': '📊 Welch (secondary)', 'value': 'welch'}],
                    value='lomb', inline=True, style={'fontSize': '14px'},
                ),
            ], style={'width': '55%', 'display': 'inline-block',
                      'textAlign': 'right', 'verticalAlign': 'top'}),
        ], style={'width': '95%', 'margin': 'auto', 'padding': '10px',
                  'backgroundColor': '#f0f0f0', 'borderRadius': '5px', 'marginBottom': '10px'}),

        # ── Stats panel — html.Div, NOT dcc.Markdown ─────────────────────────────
        # Using html.Div with children=[] means React manages a known, stable
        # component tree. Children are replaced atomically; no foreign HTML parser
        # injects nodes that React cannot track via fiber keys.
        html.Div(
            id='stats-panel',
            children=[],
            style={
                'width': '95%', 'margin': 'auto', 'padding': '16px 20px',
                'backgroundColor': '#f8f9fa', 'border': '2px solid #dee2e6',
                'borderRadius': '8px', 'fontFamily': 'monospace',
                'marginBottom': '10px',
            }
        ),

        # ── Graph containers — each has a unique id for stable React reconciliation
        html.Div(id='wrap-raw', style={'width': '95%', 'margin': 'auto', 'height': '28vh', 'marginBottom': '6px'},
                 children=[dcc.Graph(id='graph-uncorrected', style=GRAPH_STYLE, config=GRAPH_CONFIG)]),
        html.Div(id='wrap-corrected', style={'width': '95%', 'margin': 'auto', 'height': '45vh', 'marginBottom': '6px'},
                 children=[dcc.Graph(id='graph-corrected', style=GRAPH_STYLE, config=GRAPH_CONFIG)]),
        html.Div(id='wrap-rr-raw', style={'width': '95%', 'margin': 'auto', 'height': '35vh', 'marginBottom': '6px'},
                 children=[dcc.Graph(id='graph-rr-uncorrected', style=GRAPH_STYLE, config=GRAPH_CONFIG)]),
        html.Div(id='wrap-rr-corr', style={'width': '95%', 'margin': 'auto', 'height': '35vh', 'marginBottom': '6px'},
                 children=[dcc.Graph(id='graph-rr-corrected', style=GRAPH_STYLE, config=GRAPH_CONFIG)]),
        html.Div(id='wrap-kubios', style={'width': '95%', 'margin': 'auto', 'height': '35vh', 'marginBottom': '6px'},
                 children=[dcc.Graph(id='graph-kubios', style=GRAPH_STYLE, config=GRAPH_CONFIG)]),
        html.Div(id='wrap-psd', style={'width': '95%', 'margin': 'auto', 'height': '35vh', 'marginBottom': '6px'},
                 children=[dcc.Graph(id='graph-psd', style=GRAPH_STYLE, config=GRAPH_CONFIG)]),
    ], style={'maxWidth': '1400px', 'margin': 'auto', 'padding': '10px'})
    return app


# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD CALLBACK
# Inputs: trial + PSD method. Returns all 7 outputs (6 figures + stats panel)
# as real values every time — no conditional output types.
# ─────────────────────────────────────────────────────────────────────────────
@callback(
    [Output('graph-uncorrected', 'figure'),
     Output('graph-corrected', 'figure'),
     Output('graph-rr-uncorrected', 'figure'),
     Output('graph-rr-corrected', 'figure'),
     Output('graph-kubios', 'figure'),
     Output('graph-psd', 'figure'),
     Output('stats-panel', 'children')],
    [Input('trial-dropdown', 'value'),
     Input('psd-method-toggle', 'value')],
)
def update_main_dashboard(trial_name, psd_method):
    empty = go.Figure()
    if not trial_name or trial_name not in PROCESSED_DATA:
        return empty, empty, empty, empty, empty, empty, []

    data = PROCESSED_DATA[trial_name]
    metrics = data['hrv_metrics']
    t_raw = metrics['time_raw']
    t_corr = metrics['time_corrected']

    if psd_method == 'welch':
        f_clean, f_corr, method_name = (
            metrics['freq_welch_clean'], metrics['freq_welch_corrected'], "Welch")
    else:
        f_clean, f_corr, method_name = (
            metrics['freq_lomb_clean'], metrics['freq_lomb_corrected'], "Lomb-Scargle")

    artifact_mask = data['artifact_mask'][:len(data['peak_times'])]
    ectopic_mask = data['ectopic_mask'][:len(data['peak_times'])]

    m = min(len(artifact_mask), len(ectopic_mask))
    a, e = artifact_mask[:m].astype(bool), ectopic_mask[:m].astype(bool)
    n_artifact_only = int(np.sum(a & ~e))
    n_ectopic_only = int(np.sum(e & ~a))
    n_both = int(np.sum(a & e))
    n_unique_bad = int(np.sum(a | e))
    total_beats = len(data['peak_times'])

    stats = build_stats_panel(
        t_raw, t_corr, f_clean, method_name,
        total_beats, n_unique_bad, n_artifact_only, n_ectopic_only, n_both,
        benchmark=metrics.get('benchmark'),
        n_unrecoverable=metrics.get('n_unrecoverable_gaps', 0),
        breakdown=data.get('breakdown'),
        unrecorded_s=data.get('unrecorded_s', 0.0), ecg_channel=data.get('ecg_channel'),
    )

    # uirevision=trial_name → Plotly resets view on trial change but preserves
    # zoom/pan when only the method toggle fires. This also keeps Plotly from
    # doing a full DOM teardown/rebuild on every minor update, which reduces
    # Plotly-vs-React DOM conflicts.
    _ui = trial_name

    # ── 1. Raw ECG ────────────────────────────────────────────────────────
    # Red X = beats the correction moved or removed (interior beats of flagged
    # runs). The beats bounding a flagged run are real and kept, so they stay
    # green; the flagged INTERVALS themselves are shown on the RR tachogram.
    corrected_beats = np.asarray(data.get('corrected_beat_mask', artifact_mask), dtype=bool)
    corrected_beats = corrected_beats[:len(data['peak_times'])]
    # [D23] split the beats the correction touched: moved/removed vs left out of
    # the analysis altogether (inside an excluded stretch), with the reason
    _bf = data.get('beat_fate')
    fate = np.asarray(_bf if _bf is not None else [])[:len(data['peak_times'])]
    if len(fate) != len(data['peak_times']):
        fate = np.where(corrected_beats, 'moved', 'clean')
    moved_b, excl_b = fate == 'moved', fate == 'excluded'
    excl_why = np.full(len(fate), '', dtype=object)
    for r in data.get('runs', []):
        if r.get('action') == 'gap':
            excl_why[r['run_s'] + 1:r['run_e']] = r.get('exclusion_reason') or 'unrecoverable'
    fig_raw = go.Figure()
    fig_raw.add_trace(go.Scatter(
        x=data['ecg_time'], y=data['ecg_signal'],
        mode='lines', name='ECG', line=dict(color='#34495e', width=1)))
    kept_raw = ~(moved_b | excl_b | ectopic_mask.astype(bool))
    fig_raw.add_trace(go.Scatter(
        x=data['peak_times'][kept_raw], y=data['peak_y'][kept_raw],
        mode='markers', name='Normal', marker=dict(color='#27ae60', size=6)))
    if np.any(moved_b):
        fig_raw.add_trace(go.Scatter(
            x=data['peak_times'][moved_b], y=data['peak_y'][moved_b],
            mode='markers', name='Flagged (moved/removed)',
            marker=dict(color='#e74c3c', size=10, symbol='x', line=dict(width=2))))
    if np.any(excl_b):
        fig_raw.add_trace(go.Scatter(
            x=data['peak_times'][excl_b], y=data['peak_y'][excl_b], text=excl_why[excl_b],
            mode='markers', name='Excluded (not analysed)',
            hovertemplate='%{x}<br>%{text}<extra>Excluded</extra>',
            marker=dict(color='#7f8c8d', size=9, symbol='x', line=dict(width=1.5))))
    if np.any(ectopic_mask):
        fig_raw.add_trace(go.Scatter(
            x=data['peak_times'][ectopic_mask], y=data['peak_y'][ectopic_mask],
            mode='markers', name='Abnormal shape',
            marker=dict(color='#f39c12', size=8, symbol='diamond')))
    # Kubios reference peaks on the ECG: hollow rings on the real waveform.
    # Where a ring sits on flat ECG with no green dot, Kubios inserted a beat;
    # where a green dot has no ring, Kubios removed it as an extra beat.
    kpt = data.get('kubios_peak_times', pd.DatetimeIndex([]))
    kpy = data.get('kubios_peak_y', np.array([]))
    if len(kpt) and len(kpt) == len(kpy):
        fig_raw.add_trace(go.Scatter(
            x=kpt, y=kpy, mode='markers', name='Kubios peaks',
            marker=dict(color='rgba(142,68,173,0.9)', size=11, symbol='circle-open',
                        line=dict(width=2))))
    ki_t = data.get('kubios_inserted_times', pd.DatetimeIndex([]))
    ki_y = data.get('kubios_inserted_y', np.array([]))
    if len(ki_t) and len(ki_t) == len(ki_y):
        fig_raw.add_trace(go.Scatter(
            x=ki_t, y=ki_y, mode='markers', name='Kubios inserted',
            marker=dict(color='#2980b9', size=13, symbol='triangle-up',
                        line=dict(width=1.5, color='#1b4f72'))))
    kr_t = data.get('kubios_removed_times', pd.DatetimeIndex([]))
    kr_y = data.get('kubios_removed_y', np.array([]))
    if len(kr_t) and len(kr_t) == len(kr_y):
        fig_raw.add_trace(go.Scatter(
            x=kr_t, y=kr_y, mode='markers', name='Kubios removed',
            marker=dict(color='#c0392b', size=13, symbol='x-thin',
                        line=dict(width=3))))
    fig_raw.update_layout(
        title="Original Signal (with Kubios reference peaks)", uirevision=_ui,
        margin=dict(l=50, r=50, t=40, b=30),
        xaxis_title="Time", yaxis_title="mV", hovermode='closest',
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1))

    # ── 2. Corrected ECG ─────────────────────────────────────────────────
    # Original and reconstructed beats are matched by TIME, not by index: after
    # an inserted or removed beat the two series no longer share indices
    # (indexing by position used to shift every marker after the first such
    # run). Green = beat kept as detected; blue + = reconstructed beat position
    # (moved or inserted), drawn at the median R height; faint red × = where a
    # detected beat was before the correction moved or removed it.
    t_orig, y_orig = data['peak_times'], np.asarray(data['peak_y'])
    t_rc = pd.DatetimeIndex(data['peak_times_corrected'])
    orig_ns, rc_ns = t_orig.asi8, t_rc.asi8
    kept = np.isin(orig_ns, rc_ns)          # detected beat survives unchanged
    new_pos = ~np.isin(rc_ns, orig_ns)      # reconstructed beat with no detected beat there
    ctype_all = np.asarray(data.get('corrected_type', []))
    rc_type = np.array(['start'] + [str(c) for c in ctype_all])[:len(t_rc)]
    y_level = float(np.median(y_orig)) if len(y_orig) else 0.0
    fig_corr = go.Figure()
    fig_corr.add_trace(go.Scatter(
        x=data['ecg_time'], y=data['ecg_signal'],
        mode='lines', name='Original',
        line=dict(color='#95a5a6', width=1, dash='dot'), opacity=0.5))
    fig_corr.add_trace(go.Scatter(
        x=t_orig[kept], y=y_orig[kept],
        mode='markers', name='Kept',
        marker=dict(color='#27ae60', size=7)))
    gone = ~kept & ~excl_b[:len(kept)] if len(excl_b) == len(kept) else ~kept
    if np.any(gone):
        fig_corr.add_trace(go.Scatter(
            x=t_orig[gone], y=y_orig[gone],
            mode='markers', name='Detected beat (moved/removed)',
            marker=dict(color='rgba(231,76,60,0.8)', size=9, symbol='x-thin',
                        line=dict(width=2, color='rgba(231,76,60,0.8)'))))
    if len(excl_b) == len(kept) and np.any(excl_b):
        fig_corr.add_trace(go.Scatter(
            x=t_orig[excl_b], y=y_orig[excl_b], text=excl_why[excl_b],
            mode='markers', name='Excluded (not analysed)',
            hovertemplate='%{x}<br>%{text}<extra>Excluded</extra>',
            marker=dict(color='rgba(127,140,141,0.9)', size=9, symbol='x-thin',
                        line=dict(width=2, color='rgba(127,140,141,0.9)'))))
    if np.any(new_pos):
        fig_corr.add_trace(go.Scatter(
            x=t_rc[new_pos], y=np.full(int(np.sum(new_pos)), y_level),
            mode='markers', name='Reconstructed beat', text=rc_type[new_pos],
            hovertemplate='%{x}<br>%{text}<extra>Reconstructed beat</extra>',
            marker=dict(color='#3498db', size=11, symbol='cross', line=dict(width=1.5, color='#1b4f72'))))
    fig_corr.update_layout(
        title="Corrected Peak Alignments", uirevision=_ui,
        margin=dict(l=50, r=50, t=40, b=30),
        xaxis_title="Time", yaxis_title="mV", hovermode='closest',
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1))

    # ── 3. Uncorrected RR tachogram ───────────────────────────────────────
    t_orig_peaks = data['peak_times']
    rr_uncorr = (t_orig_peaks[1:] - t_orig_peaks[:-1]).total_seconds() * 1000
    t_rr_uncorr = t_orig_peaks[1:]
    local_median = (pd.Series(rr_uncorr)
                    .rolling(window=MEDIAN_WINDOW, center=True, min_periods=1)
                    .median().values)
    _bounds = data.get('rr_bounds')
    lower_thresh, upper_thresh, _c = (_bounds if _bounds is not None and len(_bounds[0]) == len(rr_uncorr)
                                      else compute_rr_bounds(rr_uncorr))
    _band_label = ("Kubios long/short" if DETECTION_METHOD == 'kubios'
                   else f"±{int(OUTLIER_THRESHOLD * 100)}%")
    ectopic_cut = ectopic_mask[:len(t_orig_peaks)]
    ect_intervals = ectopic_cut[:-1] | ectopic_cut[1:]
    # Decompose flags by REASON so each marker explains itself. In Kubios mode the
    # categories are the Lipponen–Tarvainen classes (ectopic / missed / extra /
    # long-short); 'Abnormal shape' is the separate morphology detector. A beat can
    # sit INSIDE the band yet be flagged (ectopic/missed/extra are pattern-based).
    _reasons = data.get('rr_reasons')
    if not _reasons or len(next(iter(_reasons.values()))) != len(rr_uncorr):
        _reasons = classify_rr_outlier_reasons(rr_uncorr)
    _nb = len(rr_uncorr)

    def _fit(mask):
        mask = np.asarray(mask, dtype=bool)
        if len(mask) < _nb:
            mask = np.concatenate([mask, np.zeros(_nb - len(mask), dtype=bool)])
        return mask[:_nb]

    # assign each interval to ONE category by precedence, folding morphology in
    _used = np.zeros(_nb, dtype=bool)

    def _take(mask):
        m = _fit(mask) & ~_used
        _used[m] = True
        return m

    if DETECTION_METHOD == 'kubios':
        _style_src = [
            ('Out of range / too short', _reasons.get('hard'), '#7b241c', 'x', 12),  # [D19] included
            ('Alternating rhythm', _reasons.get('alternating'), '#95a5a6', 'bowtie', 11),  # [D21]
            ('Ectopic', _reasons.get('ectopic'), '#e67e22', 'diamond', 11),
            ('Abnormal shape', ect_intervals, '#d35400', 'diamond-open', 11),
            ('Missed beat', _reasons.get('missed'), '#2980b9', 'triangle-up', 12),
            ('Extra beat', _reasons.get('extra'), '#8e44ad', 'square', 10),
            ('Long/short', _reasons.get('longshort'), '#16a085', 'circle', 10),
        ]
    else:
        _style_src = [
            ('Out of range', _reasons.get('hard'), '#7b241c', 'x', 12),
            ('Alternating rhythm', _reasons.get('alternating'), '#95a5a6', 'bowtie', 11),  # [D21]
            ('Outside band', _reasons.get('gross'), '#e74c3c', 'x', 10),
            ('Abnormal shape', ect_intervals, '#d35400', 'diamond-open', 11),
        ]
    _FLAG_STYLES = [(_take(src if src is not None else np.zeros(_nb, bool)), lbl, col, sym, sz)
                    for lbl, src, col, sym, sz in _style_src]
    fig_rr_uncorr = go.Figure()
    fig_rr_uncorr.add_trace(go.Scatter(
        x=t_rr_uncorr, y=rr_uncorr, mode='lines+markers', name='RR Interval',
        line=dict(color='#34495e', width=1), marker=dict(size=4)))
    fig_rr_uncorr.add_trace(go.Scatter(
        x=t_rr_uncorr, y=local_median, mode='lines', name='Local Median',
        line=dict(color='#7f8c8d', dash='dash', width=2)))
    fig_rr_uncorr.add_trace(go.Scatter(
        x=t_rr_uncorr, y=upper_thresh, mode='lines', name=f'Upper bound ({_band_label})',
        line=dict(color='#e74c3c', dash='dot', width=1.5)))
    fig_rr_uncorr.add_trace(go.Scatter(
        x=t_rr_uncorr, y=lower_thresh, mode='lines', name=f'Lower bound ({_band_label})',
        line=dict(color='#e74c3c', dash='dot', width=1.5)))
    for sel, lbl, col, sym, sz in _FLAG_STYLES:
        if np.any(sel):
            fig_rr_uncorr.add_trace(go.Scatter(
                x=t_rr_uncorr[sel], y=rr_uncorr[sel], mode='markers', name=lbl,
                marker=dict(color=col, size=sz, symbol=sym,
                            line=dict(width=1.5, color='#2c3e50'))))
    fig_rr_uncorr.update_layout(
        title="Uncorrected RR Intervals", uirevision=_ui,
        xaxis_title="Time", yaxis_title="RR (ms)",
        margin=dict(l=50, r=50, t=40, b=30), hovermode='closest',
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1))

    # ── 4. Corrected RR tachogram ─────────────────────────────────────────
    # Use the stored corrected RR VALUES (so replaced outliers show their
    # substituted value, not the original gap) and color-code each corrected
    # beat by how it was fixed, so it can be traced back to the flagged beat
    # in the uncorrected panel above.
    if 'corrected_rr_ms' in data and len(data['corrected_rr_ms']):
        rr_corr = np.asarray(data['corrected_rr_ms'], dtype=float)
        t_rr_corr = data['corrected_rr_times']
        ctype = data.get('corrected_type', np.array(['kept'] * len(rr_corr)))
    else:  # fallback for older cached data
        t_corr_peaks = data['peak_times_corrected']
        rr_corr = (t_corr_peaks[1:] - t_corr_peaks[:-1]).total_seconds() * 1000
        t_rr_corr = t_corr_peaks[1:]
        ctype = np.array(['kept'] * len(rr_corr))
    ctype = np.asarray(ctype)
    n_c = min(len(rr_corr), len(t_rr_corr), len(ctype))
    rr_corr, t_rr_corr, ctype = rr_corr[:n_c], t_rr_corr[:n_c], ctype[:n_c]
    local_med_c = (pd.Series(rr_corr)
                   .rolling(window=MEDIAN_WINDOW, center=True, min_periods=1)
                   .median().values)
    fig_rr_corr = go.Figure()
    fig_rr_corr.add_trace(go.Scatter(
        x=t_rr_corr, y=rr_corr, mode='lines', name='Corrected RR',
        line=dict(color='#27ae60', width=1.5)))
    fig_rr_corr.add_trace(go.Scatter(
        x=t_rr_corr, y=local_med_c, mode='lines', name='Local Median',
        line=dict(color='#7f8c8d', dash='dash', width=2)))
    _lo_c, _hi_c, _ = compute_rr_bounds(rr_corr)
    _band_label_c = ("Kubios long/short" if DETECTION_METHOD == 'kubios'
                     else f"±{int(OUTLIER_THRESHOLD * 100)}%")
    fig_rr_corr.add_trace(go.Scatter(
        x=t_rr_corr, y=_hi_c,
        mode='lines', name=f'Upper bound ({_band_label_c})',
        line=dict(color='#e74c3c', dash='dot', width=1.5)))
    fig_rr_corr.add_trace(go.Scatter(
        x=t_rr_corr, y=_lo_c,
        mode='lines', name=f'Lower bound ({_band_label_c})',
        line=dict(color='#e74c3c', dash='dot', width=1.5)))
    # kept beats: small neutral dots
    _keep = (ctype == 'kept')
    if np.any(_keep):
        fig_rr_corr.add_trace(go.Scatter(
            x=np.asarray(t_rr_corr)[_keep], y=rr_corr[_keep], mode='markers',
            name='Kept', marker=dict(size=4, color='#27ae60')))
    # corrected beats: one distinct style per correction type
    _CORR_STYLE = {
        'replaced': ('Replaced (outlier value)', '#e67e22', 'circle', 11),
        'inserted': ('Inserted (missed beat)', '#2980b9', 'triangle-up', 12),
        'merged': ('Merged (extra beat)', '#8e44ad', 'square', 10),
        'gap': ('Unrecoverable gap', '#7f8c8d', 'line-ns', 12),
    }
    for key, (lbl, col, sym, sz) in _CORR_STYLE.items():
        sel = (ctype == key)
        if np.any(sel):
            fig_rr_corr.add_trace(go.Scatter(
                x=np.asarray(t_rr_corr)[sel], y=rr_corr[sel], mode='markers',
                name=lbl, marker=dict(size=sz, color=col, symbol=sym,
                                      line=dict(width=1.5, color='#2c3e50'))))
    fig_rr_corr.update_layout(
        title="Corrected RR Intervals (corrected beats highlighted)", uirevision=_ui,
        xaxis_title="Time", yaxis_title="RR (ms)",
        margin=dict(l=50, r=50, t=40, b=30), hovermode='closest',
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1))

    # ── 4b. Kubios benchmark — what the reference method picked up ─────────
    # Overlays the original RR tachogram with the Kubios (Lipponen–Tarvainen)
    # corrected RR, and marks the beats Kubios INSERTED (missed-beat fixes) and
    # REMOVED (extra-beat fixes), derived from the original-vs-corrected peak
    # diff so it stays informative even when NeuroKit's category dict is sparse.
    bench = metrics.get('benchmark') or {}
    n_edits = bench.get('n_edits', 0)
    fig_kubios = go.Figure()
    fig_kubios.add_trace(go.Scatter(
        x=t_rr_uncorr, y=rr_uncorr, mode='lines+markers', name='Original RR',
        line=dict(color='#bdc3c7', width=1), marker=dict(size=3, color='#95a5a6')))
    kub_rr = data.get('kubios_rr', np.array([]))
    kub_rr_times = data.get('kubios_rr_times', pd.DatetimeIndex([]))
    if len(kub_rr) and len(kub_rr_times) == len(kub_rr):
        fig_kubios.add_trace(go.Scatter(
            x=kub_rr_times, y=kub_rr, mode='lines', name='Kubios RR',
            line=dict(color='#8e44ad', width=1.8)))

    def _rr_at(times, ref_times, ref_rr):
        """Nearest RR value on a tachogram for each marker time (for y-pos)."""
        if len(times) == 0 or len(ref_rr) == 0:
            return np.array([])
        ref_ns = np.asarray(ref_times, dtype='datetime64[ns]').astype('int64')
        q_ns = np.asarray(times, dtype='datetime64[ns]').astype('int64')
        pos = np.clip(np.searchsorted(ref_ns, q_ns), 0, len(ref_rr) - 1)
        return np.asarray(ref_rr)[pos]

    ins_t = data.get('kubios_inserted_times', pd.DatetimeIndex([]))
    rem_t = data.get('kubios_removed_times', pd.DatetimeIndex([]))
    if len(ins_t):
        fig_kubios.add_trace(go.Scatter(
            x=ins_t, y=_rr_at(ins_t, kub_rr_times, kub_rr),
            mode='markers', name=f'Inserted ({len(ins_t)})',
            marker=dict(color='#27ae60', size=11, symbol='triangle-up',
                        line=dict(width=1.5, color='#145a32'))))
    if len(rem_t):
        fig_kubios.add_trace(go.Scatter(
            x=rem_t, y=_rr_at(rem_t, t_rr_uncorr, rr_uncorr),
            mode='markers', name=f'Removed ({len(rem_t)})',
            marker=dict(color='#e74c3c', size=11, symbol='x',
                        line=dict(width=2))))
    title_kub = (f"Kubios Benchmark — {n_edits} beat edit(s)"
                 if bench.get('available') else "Kubios Benchmark — unavailable")
    fig_kubios.update_layout(
        title=title_kub, uirevision=_ui,
        xaxis_title="Time", yaxis_title="RR (ms)",
        margin=dict(l=50, r=50, t=40, b=30), hovermode='closest',
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1))

    # ── 5. PSD ────────────────────────────────────────────────────────────
    fig_psd = go.Figure()
    if 'frequencies' in f_clean and 'psd' in f_clean:
        fig_psd.add_trace(go.Scatter(
            x=f_clean['frequencies'], y=f_clean['psd'],
            mode='lines', name=f'{method_name} (Clean)',
            line=dict(color='#27ae60', width=2.5)))
    if 'frequencies' in f_corr and 'psd' in f_corr:
        fig_psd.add_trace(go.Scatter(
            x=f_corr['frequencies'], y=f_corr['psd'],
            mode='lines', name=f'{method_name} (Corrected)',
            line=dict(color='#3498db', width=1.5, dash='dot')))
    for x0, x1, color, label in [
        (0.0, 0.04, "purple", "VLF"),
        (0.04, 0.15, "blue", "LF"),
        (0.15, 0.40, "red", "HF"),
    ]:
        fig_psd.add_vrect(x0=x0, x1=x1, fillcolor=color, opacity=0.08,
                          annotation_text=label, annotation_position="top left")
    fig_psd.update_layout(
        title=f"PSD: {method_name}", uirevision=_ui,
        xaxis_title="Frequency (Hz)", yaxis_title="PSD (ms²/Hz)",
        yaxis_type="log", xaxis=dict(range=[0, 0.5]),
        margin=dict(l=50, r=50, t=40, b=30), hovermode='closest',
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1))

    return fig_raw, fig_corr, fig_rr_uncorr, fig_rr_corr, fig_kubios, fig_psd, stats


if __name__ == '__main__':
    main()
